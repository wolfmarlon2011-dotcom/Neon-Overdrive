    // =========================================================================
    // 8. RESPONSIVE RESIZING, IPAD MULTI-TOUCH & TASTATURSTEUERUNG
    // =========================================================================
    function handleResize() {
        var w = Math.max(1, window.innerWidth);
        var h = Math.max(1, window.innerHeight);

        if (useThree3D && camera && renderer) {
            camera.aspect = w / h;
            camera.updateProjectionMatrix();
            renderer.setSize(w, h);
        }

        if (ui.fallbackCanvas) {
            ui.fallbackCanvas.width = w;
            ui.fallbackCanvas.height = h;
        }

        if (warpGl && ui.warpCanvas) {
            ui.warpCanvas.width = w;
            ui.warpCanvas.height = h;
            warpGl.viewport(0, 0, w, h);
        }
    }

    window.addEventListener('resize', handleResize);
    window.addEventListener('orientationchange', function () {
        setTimeout(handleResize, 120);
    });

    var activeTouches = new Map();

    function updateTouchStatesFromMap() {
        touchState.left = false;
        touchState.right = false;
        touchState.gas = false;
        touchState.brake = false;
        touchState.nitro = false;

        activeTouches.forEach(function (ctrl) {
            if (ctrl && Object.prototype.hasOwnProperty.call(touchState, ctrl)) {
                touchState[ctrl] = true;
            }
        });

        document.querySelectorAll('.touch-btn').forEach(function (btn) {
            var ctrl = btn.dataset.control;
            if (touchState[ctrl]) btn.classList.add('active');
            else btn.classList.remove('active');
        });

        syncInput();
    }

    function resolveControlAtPoint(clientX, clientY) {
        var el = document.elementFromPoint(clientX, clientY);
        if (!el) return null;
        var btn = el.closest('.touch-btn');
        return btn ? btn.dataset.control : null;
    }

    if (ui.touchControls) {
        ui.touchControls.addEventListener('touchstart', function (e) {
            e.preventDefault();
            sound.init();
            sound.resume();
            for (var i = 0; i < e.changedTouches.length; i++) {
                var t = e.changedTouches[i];
                var ctrl = resolveControlAtPoint(t.clientX, t.clientY);
                if (ctrl) activeTouches.set(t.identifier, ctrl);
            }
            updateTouchStatesFromMap();
        }, { passive: false });

        ui.touchControls.addEventListener('touchmove', function (e) {
            e.preventDefault();
            for (var i = 0; i < e.changedTouches.length; i++) {
                var t = e.changedTouches[i];
                var ctrl = resolveControlAtPoint(t.clientX, t.clientY);
                if (ctrl) activeTouches.set(t.identifier, ctrl);
                else activeTouches.delete(t.identifier);
            }
            updateTouchStatesFromMap();
        }, { passive: false });

        var handleTouchEnd = function (e) {
            e.preventDefault();
            for (var i = 0; i < e.changedTouches.length; i++) {
                activeTouches.delete(e.changedTouches[i].identifier);
            }
            updateTouchStatesFromMap();
        };

        ui.touchControls.addEventListener('touchend', handleTouchEnd, { passive: false });
        ui.touchControls.addEventListener('touchcancel', handleTouchEnd, { passive: false });
    }

    document.querySelectorAll('.touch-btn').forEach(function (btn) {
        var ctrl = btn.dataset.control;
        btn.addEventListener('mousedown', function (e) {
            e.preventDefault();
            touchState[ctrl] = true;
            btn.classList.add('active');
            syncInput();
        });
        var releaseMouse = function () {
            touchState[ctrl] = false;
            btn.classList.remove('active');
            syncInput();
        };
        btn.addEventListener('mouseup', releaseMouse);
        btn.addEventListener('mouseleave', releaseMouse);
    });

