    function clearSparks() {
        for (var nci = 0; nci < nitroPool.length; nci++) {
            nitroPool[nci].life = 0;
            nitroPool[nci].mesh.visible = false;
        }
        for (var i = 0; i < sparkPool.length; i++) {
            sparkPool[i].life = 0;
            sparkPool[i].mesh.visible = false;
        }
        for (var j = 0; j < borderSparkPool.length; j++) {
            borderSparkPool[j].life = 0;
            borderSparkPool[j].mesh.visible = false;
        }
        if (borderHighlightMesh) borderHighlightMesh.visible = false;
    }

    function update3DSparks(dt) {
        if (!useThree3D) return;
        for (var ni = 0; ni < nitroPool.length; ni++) {
            var np = nitroPool[ni];
            if (np.life <= 0) continue;
            np.life -= dt;
            if (np.life <= 0) {
                np.life = 0;
                np.mesh.visible = false;
                continue;
            }
            np.mesh.position.addScaledVector(np.vel, dt);
            np.mesh.scale.setScalar(0.35 + (np.life / np.max) * 1.7);
        }
        for (var i = 0; i < sparkPool.length; i++) {
            var p = sparkPool[i];
            if (p.life <= 0) continue;
            p.life -= dt;
            if (p.life <= 0) {
                p.life = 0;
                p.mesh.visible = false;
            } else {
                p.vel.y -= 24 * dt;
                p.mesh.position.addScaledVector(p.vel, dt);
                p.mesh.scale.setScalar(Math.max(0.1, p.life * 2.5));
            }
        }

        for (var k = 0; k < borderSparkPool.length; k++) {
            var sp = borderSparkPool[k];
            if (sp.life <= 0) continue;
            sp.life -= dt;
            if (sp.life <= 0) {
                sp.life = 0;
                sp.mesh.visible = false;
            } else {
                sp.vel.y -= 26 * dt;
                sp.mesh.position.addScaledVector(sp.vel, dt);
                sp.mesh.rotation.x += 12 * dt;
                sp.mesh.rotation.y += 10 * dt;
                sp.mesh.scale.setScalar(Math.max(0.12, sp.life * 3.1));
            }
        }
    }

