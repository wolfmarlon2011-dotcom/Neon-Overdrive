    function startNewRace(e, trackIdx) {
        if (e && typeof e.preventDefault === 'function') e.preventDefault();
        if (e && typeof e.stopPropagation === 'function') e.stopPropagation();

        var nowTap = performance.now();
        if (nowTap - lastStartTriggerMs < 250) return;
        lastStartTriggerMs = nowTap;

        if (typeof trackIdx === 'number') {
            selectedTrackIndex = trackIdx;
        }

        // a) Sofort Start- & Ziel-Overlay ausblenden
        if (ui.startOverlay) {
            ui.startOverlay.style.display = 'none';
            ui.startOverlay.classList.add('hidden');
        }
        if (ui.finishOverlay) {
            ui.finishOverlay.style.display = 'none';
            ui.finishOverlay.classList.add('hidden');
        }
        if (ui.pauseScreen) {
            ui.pauseScreen.style.display = 'none';
            ui.pauseScreen.classList.add('hidden');
        }

        // b) Sofort HUD & Touch-Controls einblenden
        if (ui.hud) {
            ui.hud.classList.remove('hidden');
            ui.hud.style.display = 'flex';
        }
        if (ui.touchControls) {
            ui.touchControls.classList.remove('hidden');
            ui.touchControls.style.display = 'flex';
        }

        // c) Rennzustand und Fahrzeugwerte sofort zurücksetzen (ohne Shader/Geometrien neu zu kompilieren)
        var startNow = performance.now();
        gameState = 'COUNTDOWN';
        countdownTimer = 3.0;
        countdownShown = 0;
        player.raceTime = 0;
        player.lap = 1;
        player.progress = 0;
        player.totalDistance = 0;
        player.lateral = 0;
        player.headingAngle = 0;
        player.lateralSlideVel = 0;
        player.speed = 0;
        player.steerAngle = 0;
        player.driftAngle = 0;
        player.isDrifting = false;
        player.driftCharge = 0;
        player.nitro = 100;
        player.nitroActive = false;
        player.padBoostTimer = 0;
        player.raceStartTime = startNow;
        player.lapStartTime = startNow;
        player.currentLapTime = 0;
        player.bestLapTime = null;
        player.topSpeedRecorded = 0;
        player.invulnTimer = 0;

        cameraShake = 0;
        lastTime = 0;

        clearSparks();
        raceStats.boosts = 0;
        raceStats.nitro = 0;
        applyPlayerCar();
        buildTrackData(selectedTrackIndex, false);
        spawnAIRacers(selectedTrackIndex);
        player.steerCmd = 0;
        placePlayerOnTrack(0, 0, 0);
        player.vx = 0;
        player.vz = 0;
        player.slip = 0;
        player.camYaw = player.yaw;
        handleResize();

        if (ui.best) ui.best.textContent = '--:--.--';
        if (ui.lap) ui.lap.innerHTML = '1 <span class="hud-sub">/ ' + TOTAL_LAPS + '</span>';

        updateVisualTransforms(0.016, false, 0);
        updateHUD(0);

        // d) Render-Loop aktivieren, BEVOR Audio berührt wird
        ensureLoopRunning();
        showBanner('3', 950);

        // Web Audio komplett isoliert & non-blocking entsperren
        try {
            sound.init();
            sound.resume();
            sound.playBeep(880, 0.22, 'triangle');
        } catch (audioErr) {}
    }

    // Globale Referenz für inline onclick & ontouchend
    window.startGame = function (e) {
        startNewRace(e, selectedTrackIndex);
    };

    // =========================================================================
    // 7. FAHRPHYSIK (100% REIN MANUELLE LENKUNG, FREIE FAHRTRICHTUNG)
    // =========================================================================
    function wrapAngle(a) { return Math.atan2(Math.sin(a), Math.cos(a)); }

    function placePlayerOnTrack(progress, lateral, relHeading) {
        var fr = getFrameAtDistance(progress, (useThree3D && reusableFrameA) ? reusableFrameA : null);
        player.wx = fr.point.x + fr.right.x * lateral;
        player.wz = fr.point.z + fr.right.z * lateral;
        player.yaw = Math.atan2(fr.tangent.x, fr.tangent.z) - relHeading;
        player.progress = progress;
        player.lateral = lateral;
        player.headingAngle = relHeading;
        if (useThree3D && trackFrames) {
            player.idx = Math.round(progress / trackLength * TRACK_SAMPLES) % TRACK_SAMPLES;
        }
        if (player.camYaw === null) player.camYaw = player.yaw;
    }

    // Weltposition -> Streckenfortschritt + seitlicher Versatz (gibt den ungeclampten Versatz zurück)
    function projectPlayerToTrack() {
        if (!(useThree3D && trackFrames)) {
            player.progress = ((-player.wz % trackLength) + trackLength) % trackLength;
            return player.wx;
        }
        var N = TRACK_SAMPLES, best = player.idx, bd = Infinity;
        for (var k = -40; k <= 40; k++) {
            var i = ((player.idx + k) % N + N) % N;
            var p = trackFrames.points[i];
            var ddx = player.wx - p.x, ddz = player.wz - p.z;
            var d = ddx * ddx + ddz * ddz;
            if (d < bd) { bd = d; best = i; }
        }
        player.idx = best;
        var pt = trackFrames.points[best];
        var tg = trackFrames.tangents[best];
        var rt = trackFrames.rights[best];
        var dx = player.wx - pt.x, dz = player.wz - pt.z;
        var th = Math.sqrt(tg.x * tg.x + tg.z * tg.z) || 1;
        var spacing = trackLength / N;
        var along = Math.max(-spacing, Math.min(spacing, (dx * tg.x + dz * tg.z) / th));
        player.progress = (((best * spacing + along) % trackLength) + trackLength) % trackLength;
        return dx * rt.x + dz * rt.z;
    }

    function clampPlayerLateral(rawLat, newLat) {
        if (useThree3D && trackFrames) {
            var rt = trackFrames.rights[player.idx];
            var diff = rawLat - newLat;
            player.wx -= rt.x * diff;
            player.wz -= rt.z * diff;
        } else {
            player.wx = newLat;
        }
        player.lateral = newLat;
    }

    function updateRaceLogic(dt) {
        if (gameState !== 'RACING') return;

        var now = performance.now();
        player.raceTime = now - player.raceStartTime;
        player.currentLapTime = now - player.lapStartTime;

        if (player.invulnTimer > 0) player.invulnTimer -= dt;
        if (player.padBoostTimer > 0) player.padBoostTimer -= dt;

        var speedRatio = Math.min(1.0, player.speed / player.maxSpeed);

        if ((input.nitro && player.nitro > 3 && player.speed > 18) || player.padBoostTimer > 0) {
            player.nitroActive = true;
            if (player.padBoostTimer <= 0) {
                player.nitro = Math.max(0, player.nitro - 30 * dt);
            }
            cameraShake = Math.min(0.24, cameraShake + 1.1 * dt);
        } else {
            player.nitroActive = false;
            cameraShake = Math.max(0, cameraShake - 2.2 * dt);
            player.nitro = Math.min(100, player.nitro + 3.2 * player.nitroRegen * dt);
        }
        if (player.nitroActive && !nitroWasActive) {
            var nf = document.getElementById('nitro-flash');
            if (nf) { nf.classList.remove('go'); void nf.offsetWidth; nf.classList.add('go'); }
            cameraShake = Math.max(cameraShake, 0.22);
            if (player.padBoostTimer <= 0) sound.playPadBoost();
        }
        nitroWasActive = player.nitroActive;
        if (player.nitroActive) raceStats.nitro += dt;
        if (cheats.infNitro) player.nitro = 100;

        var effectiveTopSpeed = player.nitroActive ? player.nitroMaxSpeed : player.maxSpeed;
        var effectiveAccel = player.nitroActive ? player.accel * 1.65 : player.accel;

        if (input.gas || player.nitroActive) {
            player.speed += effectiveAccel * (1.25 - 0.7 * Math.min(1, player.speed / effectiveTopSpeed)) * dt;
        } else if (input.brake) {
            var isTurning = input.left || input.right;
            var brakePower = (isTurning && player.speed > 45) ? player.brakeDecel * 0.25 : player.brakeDecel;
            player.speed -= brakePower * dt;
        } else {
            player.speed -= player.coastDecel * dt;
        }

        if (player.speed > effectiveTopSpeed) {
            player.speed -= 45 * dt;
        }
        player.speed = Math.max(0, player.speed);

        var kmh = Math.round((player.speed / 124) * 315);
        if (kmh > player.topSpeedRecorded) player.topSpeedRecorded = kmh;

        var steerInput = (input.right ? 1 : 0) - (input.left ? 1 : 0);
        var canDrift = input.brake && player.speed > 42 && (steerInput !== 0 || player.isDrifting);

        if (canDrift) {
            player.isDrifting = true;
            player.driftCharge += dt;
            player.nitro = Math.min(100, player.nitro + 19 * dt);
        } else {
            if (player.isDrifting && player.driftCharge > (cheats.ultra ? 0.05 : 0.6)) {
                var tier = cheats.ultra ? 3 : (player.driftCharge > 2.4 ? 3 : (player.driftCharge > 1.4 ? 2 : 1));
                player.speed = Math.min(player.nitroMaxSpeed, player.speed + 6 + tier * 8);
                player.nitro = Math.min(100, player.nitro + tier * 8);
                raceStats.boosts++;
                sound.playBeep(560 + tier * 120, 0.14, 'triangle');
                showBanner(tier === 3 ? 'ULTRA BOOST!' : (tier === 2 ? 'SUPER BOOST' : 'BOOST'), 500);
            }
            player.isDrifting = false;
            player.driftCharge = 0;
        }

        // ---- 100% manuelle Lenkung: Fahrtrichtung (yaw) ändert sich NUR durch Eingabe ----
        player.steerCmd += (steerInput - player.steerCmd) * Math.min(1, 11 * dt);
        if (Math.abs(player.steerCmd) < 0.001) player.steerCmd = 0;

        var highSpeedTemper = 1.0 - 0.2 * Math.pow(speedRatio, 1.4);
        var turnRate = (player.isDrifting ? 2.15 : 1.7) * (0.22 + 0.78 * speedRatio) * highSpeedTemper * player.handling;
        player.yaw -= player.steerCmd * turnRate * dt;   // rechts = yaw sinkt
        player.steerAngle = player.steerCmd * 0.34;

        if (player.isDrifting) {
            player.lateralSlideVel = Math.max(-9, Math.min(9, player.lateralSlideVel - steerInput * 3 * dt));
        }
        player.lateralSlideVel *= Math.pow(0.55, dt);

        var targetDrift = player.isDrifting ? Math.max(-0.4, Math.min(0.4, player.slip * 0.6 + steerInput * 0.06)) : 0;
        player.driftAngle += (targetDrift - player.driftAngle) * Math.min(1, 6.5 * dt);

        // ---- Bewegung in Fahrtrichtung (Weltkoordinaten) ----
        var fx = Math.sin(player.yaw), fz = Math.cos(player.yaw);
        var rx = -Math.cos(player.yaw), rz = Math.sin(player.yaw);
        var prevProgress = player.progress;
        var grip = cheats.grip ? 60 : (player.isDrifting ? 2.4 : (9.0 - 3.0 * speedRatio)) * player.handling;
        var gk = Math.min(1, grip * dt);
        player.vx += (fx * player.speed - player.vx) * gk;
        player.vz += (fz * player.speed - player.vz) * gk;
        player.wx += (player.vx + rx * player.lateralSlideVel) * dt;
        player.wz += (player.vz + rz * player.lateralSlideVel) * dt;
        var vMag = Math.sqrt(player.vx * player.vx + player.vz * player.vz);
        player.slip = vMag > 6 ? wrapAngle(Math.atan2(player.vx, player.vz) - player.yaw) : 0;
        if (player.isDrifting) player.speed = Math.max(0, player.speed - 7 * dt);

        var rawLateral = projectPlayerToTrack();

        var dProg = player.progress - prevProgress;
        if (dProg > trackLength / 2) dProg -= trackLength;
        else if (dProg < -trackLength / 2) dProg += trackLength;
        player.totalDistance += dProg;

        // ---- Streckenrand ----
        var borderThreshold = ROAD_HALF_WIDTH - 1.55;
        var maxLateral = ROAD_HALF_WIDTH - 1.1;
        var edgePenetration = Math.max(0, Math.abs(rawLateral) - borderThreshold);
        var isScrapingBorder = edgePenetration > 0;

        if (isScrapingBorder && player.speed > 0 && !cheats.god) {
            var edgeFactor = Math.min(1.65, 0.6 + edgePenetration * 0.7);
            var borderDrag = (72 + player.speed * 0.58) * edgeFactor;
            player.speed = Math.max(0, player.speed - borderDrag * dt);
            player.lateralSlideVel *= Math.pow(0.22, dt);
            if (player.nitroActive && player.padBoostTimer <= 0) {
                player.nitro = Math.max(0, player.nitro - 18 * dt);
            }
            cameraShake = Math.max(cameraShake, Math.min(0.16, 0.05 + speedRatio * 0.11));
        }

        if (Math.abs(rawLateral) > maxLateral) {
            clampPlayerLateral(rawLateral, rawLateral < 0 ? -maxLateral : maxLateral);
            player.lateralSlideVel *= 0.2;
            player.vx *= 0.97;
            player.vz *= 0.97;
            if (!cheats.god) player.speed = Math.max(0, player.speed - 24 * dt);
            if (player.invulnTimer <= 0 && player.speed > 24) {
                sound.playCrash(0.45);
                cameraShake = Math.max(cameraShake, 0.2);
                player.invulnTimer = 0.25;
                if (useThree3D && playerVisual) spawn3DSpark(playerVisual.mesh.position, true);
            }
        } else {
            player.lateral = rawLateral;
        }

        // Relativer Winkel zur Strecke (für 2D-Modus & Anzeige)
        var tf = getFrameAtDistance(player.progress, (useThree3D && reusableFrameA) ? reusableFrameA : null);
        player.headingAngle = wrapAngle(Math.atan2(tf.tangent.x, tf.tangent.z) - player.yaw);

        // ---- Rundenzähler (über gefahrene Gesamtstrecke) ----
        if (player.totalDistance >= player.lap * trackLength) {
            if (player.bestLapTime === null || player.currentLapTime < player.bestLapTime) {
                player.bestLapTime = player.currentLapTime;
                ui.best.textContent = formatTime(player.bestLapTime);
            }
            player.lapStartTime = performance.now();

            if (player.lap >= TOTAL_LAPS) {
                finishRace();
                return;
            } else {
                player.lap++;
                ui.lap.innerHTML = player.lap + ' <span class="hud-sub">/ ' + TOTAL_LAPS + '</span>';
                if (player.lap === TOTAL_LAPS) {
                    showBanner('LETZTE RUNDE!', 1500);
                    sound.playBeep(784, 0.22, 'triangle');
                } else {
                    showBanner('RUNDE ' + player.lap + ' / ' + TOTAL_LAPS, 1200);
                    sound.playBeep(587, 0.18, 'triangle');
                }
            }
        }

        for (var i = 0; i < nitroPads.length; i++) {
            var pad = nitroPads[i];
            var dz = pad.dist - player.progress;
            if (dz > trackLength / 2) dz -= trackLength;
            if (dz < -trackLength / 2) dz += trackLength;

            if (Math.abs(dz) < 5.5 && Math.abs(player.lateral - pad.offset) < 2.6) {
                if (player.padBoostTimer <= 0.2) {
                    sound.playPadBoost();
                    showBanner('TURBO PAD!', 650);
                }
                player.padBoostTimer = 1.25;
                player.nitro = Math.min(100, player.nitro + 35);
                player.speed = Math.min(player.nitroMaxSpeed, player.speed + 24);
            }
        }

        for (var rgI = 0; rgI < flyRings.length; rgI++) {
            var rg = flyRings[rgI];
            var rgDz = rg.dist - player.progress;
            if (rgDz > trackLength / 2) rgDz -= trackLength;
            if (rgDz < -trackLength / 2) rgDz += trackLength;
            if (Math.abs(rgDz) < 3 && !rg.hit) {
                rg.hit = true;
                if (Math.abs(player.lateral) < 5) {
                    player.nitro = Math.min(100, player.nitro + 10);
                    player.speed = Math.min(player.nitroMaxSpeed, player.speed + 3);
                    sound.playBeep(900, 0.08, 'triangle');
                }
            } else if (Math.abs(rgDz) > 20) {
                rg.hit = false;
            }
        }

        updateAIRacers(dt);
        updateVisualTransforms(dt, isScrapingBorder, speedRatio);
        update3DSparks(dt);
        sound.update(speedRatio, player.isDrifting, player.nitroActive, true, isScrapingBorder);
        updateHUD(kmh);
    }

    function updateAIRacers(dt) {
        var carHalfWidth = 1.15;
        var carHalfLength = 2.35;
        var playerMoved = false;

        for (var i = 0; i < aiRacers.length; i++) {
            var ai = aiRacers[i];
            var gapToPlayer = player.totalDistance - ai.totalDistance;
            var rubberBand = 1.0;
            if (gapToPlayer > 140) rubberBand = 1.11;
            else if (gapToPlayer < -160) rubberBand = 0.91;

            var targetSpeed = ai.baseMaxSpeed * rubberBand;
            ai.speed += (targetSpeed - ai.speed) * Math.min(1, 2.2 * dt);

            var step = ai.speed * dt;
            ai.progress = (ai.progress + step) % trackLength;
            ai.totalDistance += step;

            ai.laneTimer -= dt;
            if (ai.laneTimer <= 0) {
                ai.laneTimer = 1.6 + Math.random() * 2.2;
                var lanes = [-8.5, -4.2, 0.0, 4.2, 8.5];
                ai.targetLateral = lanes[Math.floor(Math.random() * lanes.length)];
            }

            for (var j = 0; j < aiRacers.length; j++) {
                if (i === j) continue;
                var other = aiRacers[j];
                var oDz = other.progress - ai.progress;
                if (oDz > trackLength / 2) oDz -= trackLength;
                if (oDz < -trackLength / 2) oDz += trackLength;

                if (oDz > 0 && oDz < 16 && Math.abs(other.lateral - ai.lateral) < 3.0) {
                    ai.targetLateral = other.lateral > 0 ? Math.max(-9.5, other.lateral - 4.8) : Math.min(9.5, other.lateral + 4.8);
                }
            }

            var prevLat = ai.lateral;
            ai.lateral += (ai.targetLateral - ai.lateral) * Math.min(1, 2.4 * dt);
            ai.steerAngle = Math.max(-0.25, Math.min(0.25, (ai.lateral - prevLat) * 2.5));
            ai.nitroActive = rubberBand > 1.05;

            var dz = ai.progress - player.progress;
            if (dz > trackLength / 2) dz -= trackLength;
            if (dz < -trackLength / 2) dz += trackLength;

            var dx = ai.lateral - player.lateral;
            var minZ = carHalfLength * 2;
            var minX = carHalfWidth * 2;

            if (Math.abs(dz) < minZ && Math.abs(dx) < minX && !cheats.ghost && !cheats.god) {
                playerMoved = true;
                var overlapZ = minZ - Math.abs(dz);
                var overlapX = minX - Math.abs(dx);

                if (overlapX < overlapZ) {
                    var pushDir = dx > 0 ? -1 : 1;
                    player.lateral += pushDir * (overlapX * 0.65);
                    ai.lateral -= pushDir * (overlapX * 0.35);
                    player.lateralSlideVel = pushDir * 8;
                    player.speed *= 0.96;

                    if (player.invulnTimer <= 0) {
                        sound.playCrash(0.65);
                        cameraShake = Math.max(cameraShake, 0.25);
                        player.invulnTimer = 0.3;
                        if (useThree3D && playerVisual) spawn3DSpark(playerVisual.mesh.position, true);
                    }
                } else {
                    if (dz > 0) {
                        player.progress = (ai.progress - minZ - 0.2 + trackLength) % trackLength;
                        if (player.speed > ai.speed) {
                            var impact = (player.speed - ai.speed) / player.maxSpeed;
                            player.speed = Math.max(ai.speed * 0.85, 25);
                            ai.speed = Math.min(ai.baseMaxSpeed * 1.18, ai.speed + 14);
                            if (player.invulnTimer <= 0) {
                                sound.playCrash(Math.max(0.5, impact * 1.5));
                                cameraShake = Math.max(cameraShake, 0.3);
                                player.invulnTimer = 0.35;
                                if (useThree3D && playerVisual) spawn3DSpark(playerVisual.mesh.position, false);
                            }
                        }
                    } else {
                        ai.progress = (player.progress - minZ - 0.2 + trackLength) % trackLength;
                        ai.speed = player.speed * 0.88;
                    }
                }
            }
        }

        if (playerMoved) placePlayerOnTrack(player.progress, player.lateral, player.headingAngle);
    }

    function updateVisualTransforms(dt, isScrapingBorder, speedRatio) {
        lastScraping = !!isScrapingBorder;
        if (!useThree3D || !window.THREE || !renderer || !camera || !playerVisual) {
            return;
        }

        var pFrame = getFrameAtDistance(player.progress, reusableFrameA);
        var tanH = Math.sqrt(pFrame.tangent.x * pFrame.tangent.x + pFrame.tangent.z * pFrame.tangent.z) || 1;
        var slope = pFrame.tangent.y / tanH;
        var cfx = Math.sin(player.yaw), cfz = Math.cos(player.yaw);
        var crx = -Math.cos(player.yaw), crz = Math.sin(player.yaw);

        var hoverY = isFlying ? 2.6 + Math.sin(performance.now() * 0.003) * 0.25 : 0;
        tmpVecA.set(player.wx, pFrame.point.y + hoverY, player.wz);
        playerVisual.mesh.position.copy(tmpVecA);
        tmpVecB.set(tmpVecA.x + cfx, tmpVecA.y + slope, tmpVecA.z + cfz);
        playerVisual.mesh.lookAt(tmpVecB);
        playerVisual.mesh.rotateY(-player.driftAngle);
        playerVisual.mesh.rotateZ(player.steerAngle * (isFlying ? 1.1 : 0.16));

        var wheelSpin = player.speed * dt * 2.4;
        for (var wi = 0; wi < playerVisual.wheels.length; wi++) {
            var w = playerVisual.wheels[wi];
            w.children[0].rotation.x += wheelSpin;
            w.children[1].rotation.x += wheelSpin;
            if (wi < 2) w.rotation.y = -player.steerAngle * 0.95;
        }

        for (var fi = 0; fi < playerVisual.flames.length; fi++) {
            var f = playerVisual.flames[fi];
            f.visible = player.nitroActive;
            if (player.nitroActive) {
                f.scale.set(1.05 + Math.random() * 0.3, 1.05 + Math.random() * 0.3, 1.5 + Math.random() * 0.9);
            }
        }
        if (player.nitroActive && gameState === 'RACING') {
            for (var exs = -1; exs <= 1; exs += 2) {
                spawnNitroParticle(
                    tmpVecA.x - cfx * 3.1 + crx * 0.55 * exs, tmpVecA.y + 0.5, tmpVecA.z - cfz * 3.1 + crz * 0.55 * exs,
                    -cfx * 6 + (Math.random() - 0.5) * 3, (Math.random() - 0.3) * 2, -cfz * 6 + (Math.random() - 0.5) * 3
                );
            }
        }
        playerVisual.tailLightMat.color.setHex((input.brake || player.isDrifting) ? 0xff0022 : 0xaa0033);

        if (player.isDrifting && gameState === 'RACING') {
            tmpVecC.set(tmpVecA.x - crx, tmpVecA.y + 0.25, tmpVecA.z - crz);
            spawn3DSpark(tmpVecC, false);
            tmpVecC.set(tmpVecA.x + crx, tmpVecA.y + 0.25, tmpVecA.z + crz);
            spawn3DSpark(tmpVecC, true);
        }

        if (borderHighlightMesh && borderHighlightMat) {
            var activeScrape = isScrapingBorder && gameState === 'RACING' && player.speed > 4;
            if (activeScrape) {
                var sideSign = player.lateral >= 0 ? 1 : -1;
                tmpVecC.copy(pFrame.point).addScaledVector(pFrame.right, sideSign * (ROAD_HALF_WIDTH + 0.45));
                tmpVecC.y += 0.85 + hoverY;
                borderHighlightMesh.visible = true;
                borderHighlightMesh.position.copy(tmpVecC);
                tmpVecD.copy(tmpVecC).add(pFrame.tangent);
                borderHighlightMesh.lookAt(tmpVecD);

                var pulse = 0.45 + 0.35 * Math.sin(performance.now() * 0.032);
                borderHighlightMat.opacity = Math.min(0.88, pulse * (0.45 + speedRatio * 0.55));
                borderHighlightMat.color.setHex(player.nitroActive ? 0x00f3ff : 0xff6a00);

                if (speedRatio > 0.12 && Math.random() < 0.75) {
                    tmpVecD.copy(pFrame.right).multiplyScalar(-sideSign);
                    tmpVecE.copy(pFrame.point).addScaledVector(pFrame.right, sideSign * (ROAD_HALF_WIDTH - 0.35));
                    tmpVecE.y += 0.45 + hoverY;
                    spawnBorderScrapeSpark(tmpVecE, tmpVecD, speedRatio);
                }
            } else {
                borderHighlightMat.opacity = Math.max(0, borderHighlightMat.opacity - 5 * dt);
                if (borderHighlightMat.opacity <= 0.02) {
                    borderHighlightMesh.visible = false;
                }
            }
        }

        for (var i = 0; i < aiRacers.length; i++) {
            var ai = aiRacers[i];
            if (!ai.visual || !ai.visual.mesh) continue;
            var aFrame = getFrameAtDistance(ai.progress, reusableFrameB);
            tmpVecC.copy(aFrame.point).addScaledVector(aFrame.right, ai.lateral);
            if (isFlying) tmpVecC.y += 2.6 + Math.sin(performance.now() * 0.003 + i) * 0.25;
            ai.visual.mesh.position.copy(tmpVecC);
            tmpVecD.copy(tmpVecC).add(aFrame.tangent);
            ai.visual.mesh.lookAt(tmpVecD);
            ai.visual.mesh.rotateY(-ai.steerAngle);

            var aiSpin = ai.speed * dt * 2.4;
            for (var awi = 0; awi < ai.visual.wheels.length; awi++) {
                var aw = ai.visual.wheels[awi];
                aw.children[0].rotation.x += aiSpin;
                aw.children[1].rotation.x += aiSpin;
            }
            for (var afi = 0; afi < ai.visual.flames.length; afi++) {
                ai.visual.flames[afi].visible = ai.nitroActive;
            }
        }

        var targetFov = player.nitroActive ? 81 : (70 + (player.speed / player.maxSpeed) * 7);
        camera.fov += (targetFov - camera.fov) * Math.min(1, 6 * dt);
        camera.updateProjectionMatrix();

        player.camYaw += wrapAngle(player.yaw + player.slip * 0.55 - player.camYaw) * Math.min(1, 6 * dt);
        var kfx = Math.sin(player.camYaw), kfz = Math.cos(player.camYaw);
        var camBackDist = player.nitroActive ? 8.4 : 7.8;
        var camHeight = 3.6;
        tmpVecC.set(tmpVecA.x - kfx * camBackDist, tmpVecA.y - slope * camBackDist + camHeight, tmpVecA.z - kfz * camBackDist);

        if (cameraShake > 0 && settings.shake) {
            tmpVecC.x += (Math.random() - 0.5) * cameraShake;
            tmpVecC.y += (Math.random() - 0.5) * cameraShake;
        }

        camera.position.lerp(tmpVecC, Math.min(1, 18 * dt));
        tmpVecD.set(tmpVecA.x + kfx * 16, tmpVecA.y + slope * 16 + 1.4, tmpVecA.z + kfz * 16);
        camera.lookAt(tmpVecD);
        camera.rotateZ(-player.steerCmd * 0.05 * (0.3 + speedRatio));

        if (windMat) {
            var tSec = performance.now() * 0.001;
            var showW = gameState === 'RACING' && (speedRatio > 0.45 || player.nitroActive);
            windMat.opacity = player.nitroActive ? 0.7 : 0.35 * speedRatio;
            for (var wsI = 0; wsI < windStreaks.length; wsI++) {
                var ws = windStreaks[wsI];
                ws.mesh.visible = showW;
                if (!showW) continue;
                var dW = 40 - ((ws.phase * 80 + tSec * player.speed * 1.2) % 80);
                ws.mesh.position.set(tmpVecA.x + crx * ws.ox + cfx * dW, tmpVecA.y + ws.oy, tmpVecA.z + crz * ws.ox + cfz * dW);
                ws.mesh.rotation.y = player.yaw;
                ws.mesh.scale.z = 1 + speedRatio * 3;
            }
        }
    }

    // 60-FPS 2D Pseudo-3D Canvas Renderer (sofort fahrbereit innerhalb 16ms)
    function render2DFallback(isScrapingBorder) {
        var canvas = ui.fallbackCanvas;
        if (!canvas) return;
        var ctx = canvas.getContext('2d');
        if (!ctx) return;
        var w = canvas.width;
        var h = canvas.height;
        var horizonY = h * 0.44;
        var cfg = TRACK_CONFIGS[selectedTrackIndex] || TRACK_CONFIGS[0];

        var skyGrad = ctx.createLinearGradient(0, 0, 0, horizonY);
        skyGrad.addColorStop(0, '#050212');
        skyGrad.addColorStop(1, '#260a47');
        ctx.fillStyle = skyGrad;
        ctx.fillRect(0, 0, w, horizonY);

        var sunR = Math.min(w, h) * 0.14;
        var sunGrad = ctx.createLinearGradient(0, horizonY - sunR * 1.6, 0, horizonY + sunR * 0.2);
        sunGrad.addColorStop(0, '#ffe600');
        sunGrad.addColorStop(1, '#ff007f');
        ctx.fillStyle = sunGrad;
        ctx.beginPath();
        ctx.arc(w * 0.5, horizonY - sunR * 0.25, sunR, Math.PI, 0);
        ctx.fill();

        ctx.fillStyle = '#09051a';
        ctx.fillRect(0, horizonY, w, h - horizonY);

        var roadHalfTop = w * 0.04;
        var roadHalfBot = w * 0.44;
        var camShift = -(player.lateral / ROAD_HALF_WIDTH) * (w * 0.24);

        ctx.fillStyle = cfg.roadColor;
        ctx.beginPath();
        ctx.moveTo(w * 0.5 - roadHalfTop, horizonY);
        ctx.lineTo(w * 0.5 + roadHalfTop, horizonY);
        ctx.lineTo(w * 0.5 + roadHalfBot + camShift, h);
        ctx.lineTo(w * 0.5 - roadHalfBot + camShift, h);
        ctx.closePath();
        ctx.fill();

        var stripes = 22;
        var scroll = (player.progress * 0.08) % 1;
        for (var i = 0; i < stripes; i++) {
            var t0 = Math.pow((i + scroll) / stripes, 1.7);
            var t1 = Math.pow((i + 1 + scroll) / stripes, 1.7);
            var y0 = horizonY + t0 * (h - horizonY);
            var y1 = horizonY + t1 * (h - horizonY);
            var hw0 = roadHalfTop + (roadHalfBot - roadHalfTop) * t0;
            var hw1 = roadHalfTop + (roadHalfBot - roadHalfTop) * t1;
            var cx0 = w * 0.5 + camShift * t0;
            var cx1 = w * 0.5 + camShift * t1;
            var isAlt = ((i + Math.floor(player.progress * 0.08)) % 2) === 0;

            ctx.fillStyle = isAlt ? cfg.curbColor1 : cfg.curbColor2;
            ctx.beginPath();
            ctx.moveTo(cx0 - hw0 * 1.05, y0);
            ctx.lineTo(cx0 - hw0 * 0.96, y0);
            ctx.lineTo(cx1 - hw1 * 0.96, y1);
            ctx.lineTo(cx1 - hw1 * 1.05, y1);
            ctx.fill();

            ctx.beginPath();
            ctx.moveTo(cx0 + hw0 * 0.96, y0);
            ctx.lineTo(cx0 + hw0 * 1.05, y0);
            ctx.lineTo(cx1 + hw1 * 1.05, y1);
            ctx.lineTo(cx1 + hw1 * 0.96, y1);
            ctx.fill();

            if (isAlt) {
                ctx.fillStyle = 'rgba(255,255,255,0.65)';
                ctx.beginPath();
                ctx.moveTo(cx0 - hw0 * 0.015, y0);
                ctx.lineTo(cx0 + hw0 * 0.015, y0);
                ctx.lineTo(cx1 + hw1 * 0.015, y1);
                ctx.lineTo(cx1 - hw1 * 0.015, y1);
                ctx.fill();
            }
        }

        // KI-Gegner im 2D-Modus zeichnen
        for (var a = 0; a < aiRacers.length; a++) {
            var ai = aiRacers[a];
            var dz = ai.progress - player.progress;
            if (dz < -trackLength / 2) dz += trackLength;
            if (dz > trackLength / 2) dz -= trackLength;
            if (dz > 2 && dz < 220) {
                var depth = Math.max(0.05, 1 - dz / 220);
                var pDepth = Math.pow(depth, 1.5);
                var ay = horizonY + pDepth * (h - horizonY);
                var roadHalf = roadHalfTop + (roadHalfBot - roadHalfTop) * pDepth;
                var ax = w * 0.5 + camShift * pDepth + (ai.lateral / ROAD_HALF_WIDTH) * roadHalf;
                var cw = 96 * pDepth;
                var ch = 46 * pDepth;
                ctx.fillStyle = ai.colorHex || '#ff007f';
                ctx.fillRect(ax - cw * 0.5, ay - ch, cw, ch);
                ctx.fillStyle = '#ffffff';
                ctx.font = 'bold ' + Math.max(10, Math.round(14 * pDepth)) + 'px Orbitron, sans-serif';
                ctx.textAlign = 'center';
                ctx.fillText(ai.name, ax, ay - ch - 4);
            }
        }

        // Spielerfahrzeug unten mittig
        var carW = Math.min(130, w * 0.16);
        var carH = carW * 0.46;
        var carX = w * 0.5;
        var carY = h * 0.84;
        ctx.save();
        ctx.translate(carX, carY);
        ctx.rotate((player.headingAngle + player.driftAngle) * 0.55);
        ctx.fillStyle = '#0d0924';
        ctx.strokeStyle = CARS[save.car].hex;
        ctx.lineWidth = 3;
        ctx.fillRect(-carW * 0.5, -carH * 0.5, carW, carH);
        ctx.strokeRect(-carW * 0.5, -carH * 0.5, carW, carH);
        ctx.fillStyle = '#ff0044';
        ctx.fillRect(-carW * 0.42, carH * 0.25, carW * 0.84, carH * 0.14);
        if (player.nitroActive) {
            ctx.fillStyle = '#00f3ff';
            ctx.fillRect(-carW * 0.28, carH * 0.48, carW * 0.16, carH * 0.35);
            ctx.fillRect(carW * 0.12, carH * 0.48, carW * 0.16, carH * 0.35);
        }
        ctx.restore();

        if (isScrapingBorder && player.speed > 4 && gameState === 'RACING') {
            var sparkSide = player.lateral >= 0 ? 1 : -1;
            var sx = carX + sparkSide * (carW * 0.54);
            var sy = carY;
            for (var sp = 0; sp < 8; sp++) {
                ctx.fillStyle = sp % 2 === 0 ? '#ff7b00' : '#00f3ff';
                ctx.fillRect(
                    sx - sparkSide * Math.random() * 26,
                    sy + (Math.random() - 0.5) * 28,
                    4,
                    4
                );
            }
        }
    }

