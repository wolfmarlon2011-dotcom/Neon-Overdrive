    function normKey(e) {
        if (e.code) return e.code;
        var k = String(e.key || '');
        var m = {
            'ArrowLeft': 'ArrowLeft', 'ArrowRight': 'ArrowRight', 'ArrowUp': 'ArrowUp', 'ArrowDown': 'ArrowDown',
            ' ': 'Space', 'Spacebar': 'Space', 'Enter': 'Enter', 'Shift': 'ShiftLeft', 'Escape': 'Escape',
            'a': 'KeyA', 'd': 'KeyD', 'w': 'KeyW', 's': 'KeyS', 'e': 'KeyE', 'm': 'KeyM', 'r': 'KeyR', 'p': 'KeyP'
        };
        return m[k] || m[k.toLowerCase()] || '';
    }

    window.addEventListener('keydown', function (e) {
        var kc = normKey(e);
        if (e.key && e.key.length === 1 && gameState === 'MENU') {
            cheatBuf = (cheatBuf + e.key.toLowerCase()).slice(-5);
            if (cheatBuf === 'cheat') { cheatBuf = ''; openCheatMenu(); }
        }
        var isGameplayActive = gameState === 'RACING' || gameState === 'COUNTDOWN';
        if (isGameplayActive && document.activeElement && document.activeElement.blur && document.activeElement !== document.body) {
            document.activeElement.blur();
        }
        if (['ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight', 'Space'].indexOf(kc) !== -1) {
            e.preventDefault();
        }
        if (kc === 'ArrowLeft' || kc === 'KeyA') keyState.left = true;
        if (kc === 'ArrowRight' || kc === 'KeyD') keyState.right = true;
        if (kc === 'ArrowUp' || kc === 'KeyW') keyState.gas = true;
        if (kc === 'ArrowDown' || kc === 'KeyS' || kc === 'Space') keyState.brake = true;
        if (kc === 'ShiftLeft' || kc === 'ShiftRight' || kc === 'KeyE' || (kc === 'Enter' && isGameplayActive)) keyState.nitro = true;

        if (kc === 'KeyM' && !e.repeat) {
            toggleMuteUI();
        }
        if (kc === 'KeyR' && !e.repeat && (isGameplayActive || gameState === 'PAUSED' || gameState === 'FINISHED')) {
            startNewRace(e, selectedTrackIndex);
        }
        if ((kc === 'Enter' || kc === 'Space') && !e.repeat && gameState === 'MENU' && !ui.startOverlay.classList.contains('hidden')) {
            startNewRace(e, selectedTrackIndex);
        }

        if ((kc === 'KeyP' || kc === 'Escape') && !e.repeat) {
            if (gameState === 'RACING') ui.btnPause.click();
            else if (gameState === 'PAUSED') document.getElementById('btn-resume').click();
        }

        syncInput();
    });

    window.addEventListener('keyup', function (e) {
        var kc = normKey(e);
        if (kc === 'ArrowLeft' || kc === 'KeyA') keyState.left = false;
        if (kc === 'ArrowRight' || kc === 'KeyD') keyState.right = false;
        if (kc === 'ArrowUp' || kc === 'KeyW') keyState.gas = false;
        if (kc === 'ArrowDown' || kc === 'KeyS' || kc === 'Space') keyState.brake = false;
        if (kc === 'ShiftLeft' || kc === 'ShiftRight' || kc === 'KeyE' || kc === 'Enter') keyState.nitro = false;
        syncInput();
    });

