<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <title>NEON OVERDRIVE 3D // iPad Arcade Racer</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Asynchrones Laden von Three.js 0.128.0 mit automatischem jsDelivr-Fallback -->
    <script id="three-cdn" async src="https://unpkg.com/three@0.128.0/build/three.min.js" onerror="if(!this.dataset.fb){this.dataset.fb='1';var s=document.createElement('script');s.async=true;s.src='https://cdn.jsdelivr.net/npm/three@0.128.0/build/three.min.js';document.head.appendChild(s);}"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@500;700;900&family=Rajdhani:wght@500;700&display=swap');

        :root {
            --neon-pink: #ff007f;
            --neon-cyan: #00f3ff;
            --neon-purple: #9d00ff;
            --neon-yellow: #ffe600;
            --neon-green: #00ff88;
            --dark-bg: #05020e;
            --hud-bg: rgba(10, 6, 28, 0.76);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            user-select: none;
            -webkit-user-select: none;
            -webkit-touch-callout: none;
        }

        html, body {
            width: 100%;
            height: 100%;
            overflow: hidden;
            background-color: var(--dark-bg);
            font-family: 'Rajdhani', sans-serif;
            color: #ffffff;
            touch-action: none;
        }

        #game-container {
            position: relative;
            width: 100vw;
            height: 100vh;
            height: 100dvh;
            overflow: hidden;
            background: radial-gradient(circle at 50% 25%, #19093b 0%, #05020e 78%);
        }

        #three-mount,
        #fallback-canvas {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
        }

        #three-mount {
            z-index: 1;
        }

        #fallback-canvas {
            z-index: 2;
        }

        /* Augenschonender WebGL Nitro Edge-Streak Overlay (nur <14% an linken & rechten Rändern) */
        #warp-canvas {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 5;
            opacity: 0;
            transition: opacity 0.2s ease;
        }

        /* ================= HUD OVERLAY ================= */
        #hud {
            position: absolute;
            inset: 0;
            pointer-events: none;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: max(12px, env(safe-area-inset-top)) max(16px, env(safe-area-inset-right)) max(12px, env(safe-area-inset-bottom)) max(16px, env(safe-area-inset-left));
            z-index: 20;
        }

        .hud-top {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 8px;
            flex-wrap: wrap;
        }

        .hud-stats-group {
            display: flex;
            gap: 8px;
            align-items: stretch;
            flex-wrap: wrap;
        }

        .hud-panel {
            background: var(--hud-bg);
            border: 1.5px solid rgba(0, 243, 255, 0.45);
            box-shadow: 0 0 15px rgba(0, 243, 255, 0.2), inset 0 0 10px rgba(0, 243, 255, 0.1);
            border-radius: 12px;
            padding: 7px 14px;
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
        }

        .hud-panel.pink {
            border-color: rgba(255, 0, 127, 0.55);
            box-shadow: 0 0 15px rgba(255, 0, 127, 0.25), inset 0 0 10px rgba(255, 0, 127, 0.1);
        }

        .hud-label {
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 1.4px;
            color: var(--neon-cyan);
            opacity: 0.9;
            font-weight: 700;
        }

        .hud-panel.pink .hud-label {
            color: var(--neon-pink);
        }

        .hud-value {
            font-family: 'Orbitron', sans-serif;
            font-size: 1.35rem;
            font-weight: 900;
            letter-spacing: 1px;
            text-shadow: 0 0 8px rgba(255, 255, 255, 0.45);
        }

        .hud-sub {
            font-size: 0.8rem;
            color: #cbd5e1;
            font-weight: 700;
        }

        .nitro-wrapper {
            min-width: 155px;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .nitro-bar-outer {
            width: 100%;
            height: 11px;
            background: rgba(255, 255, 255, 0.14);
            border-radius: 6px;
            overflow: hidden;
            margin-top: 4px;
            border: 1px solid rgba(0, 243, 255, 0.4);
        }

        .nitro-bar-inner {
            height: 100%;
            width: 100%;
            background: linear-gradient(90deg, var(--neon-cyan), #8be9fd, var(--neon-pink));
            box-shadow: 0 0 10px rgba(0, 243, 255, 0.55);
            transition: width 0.06s linear;
        }

        .nitro-ready-glow {
            animation: pulseNitro 0.75s infinite alternate;
        }

        @keyframes pulseNitro {
            from { box-shadow: 0 0 8px rgba(0, 243, 255, 0.35); }
            to { box-shadow: 0 0 16px rgba(0, 243, 255, 0.65); }
        }

        .rivals-panel {
            min-width: 165px;
            font-size: 0.78rem;
        }

        .rival-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 8px;
            padding: 1px 0;
            font-family: 'Orbitron', sans-serif;
            font-size: 0.72rem;
        }

        .rival-row.is-player {
            color: var(--neon-cyan);
            font-weight: 900;
        }

        .hud-actions {
            display: flex;
            gap: 8px;
            pointer-events: auto;
        }

        .icon-btn {
            background: var(--hud-bg);
            border: 1.5px solid rgba(0, 243, 255, 0.5);
            color: #fff;
            width: 46px;
            height: 46px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            touch-action: manipulation;
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
            transition: transform 0.1s, background 0.15s;
        }

        .icon-btn:active {
            transform: scale(0.92);
            background: rgba(0, 243, 255, 0.25);
        }

        #race-banner {
            position: absolute;
            top: 28%;
            left: 50%;
            transform: translate(-50%, -50%);
            font-family: 'Orbitron', sans-serif;
            font-size: clamp(2rem, 5.5vw, 4.2rem);
            font-weight: 900;
            text-align: center;
            color: #fff;
            text-shadow: 0 0 15px var(--neon-pink), 0 0 35px var(--neon-cyan);
            pointer-events: none;
            opacity: 0;
            transition: opacity 0.18s ease, transform 0.18s ease;
            z-index: 25;
            white-space: nowrap;
        }

        #race-banner.show {
            opacity: 1;
            transform: translate(-50%, -50%) scale(1.06);
        }

        .hud-bottom-bar {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 6px;
            pointer-events: none;
        }

        #engine-pill {
            background: rgba(10, 6, 28, 0.62);
            border: 1px solid rgba(0, 243, 255, 0.35);
            border-radius: 999px;
            padding: 2px 10px;
            font-family: 'Orbitron', sans-serif;
            font-size: 0.64rem;
            letter-spacing: 1px;
            color: #72f8ff;
        }

        #keyboard-hud-hint {
            background: rgba(10, 6, 28, 0.58);
            border: 1px solid rgba(0, 243, 255, 0.25);
            border-radius: 999px;
            padding: 3px 12px;
            font-size: 0.72rem;
            letter-spacing: 0.6px;
            color: rgba(226, 232, 240, 0.85);
            backdrop-filter: blur(6px);
            -webkit-backdrop-filter: blur(6px);
        }

        /* ================= IPAD MULTI-TOUCH CONTROLS ================= */
        #touch-controls {
            position: absolute;
            bottom: max(16px, env(safe-area-inset-bottom));
            left: max(16px, env(safe-area-inset-left));
            right: max(16px, env(safe-area-inset-right));
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            pointer-events: none;
            z-index: 30;
        }

        .control-cluster {
            display: flex;
            gap: 12px;
            pointer-events: auto;
            align-items: flex-end;
        }

        .touch-btn {
            background: rgba(12, 8, 32, 0.56);
            border: 2px solid rgba(0, 243, 255, 0.55);
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.5), inset 0 0 14px rgba(0, 243, 255, 0.15);
            border-radius: 20px;
            color: #fff;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            backdrop-filter: blur(5px);
            -webkit-backdrop-filter: blur(5px);
            transition: transform 0.06s ease, background 0.08s ease, box-shadow 0.08s ease;
            cursor: pointer;
            touch-action: none;
        }

        .steer-btn {
            width: clamp(82px, 12vw, 114px);
            height: clamp(82px, 12vw, 114px);
        }

        .pedal-btn {
            width: clamp(76px, 11vw, 102px);
            height: clamp(92px, 14vw, 128px);
        }

        .nitro-btn {
            width: clamp(72px, 10vw, 94px);
            height: clamp(72px, 10vw, 94px);
            border-color: rgba(255, 230, 0, 0.72);
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.5), inset 0 0 14px rgba(255, 230, 0, 0.2);
        }

        .brake-btn {
            border-color: rgba(255, 0, 127, 0.65);
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.5), inset 0 0 14px rgba(255, 0, 127, 0.18);
        }

        .gas-btn {
            border-color: rgba(0, 255, 136, 0.65);
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.5), inset 0 0 14px rgba(0, 255, 136, 0.18);
        }

        .touch-btn.active {
            transform: scale(0.93);
            background: rgba(0, 243, 255, 0.35);
            box-shadow: 0 0 24px rgba(0, 243, 255, 0.75), inset 0 0 18px rgba(255, 255, 255, 0.35);
        }

        .brake-btn.active {
            background: rgba(255, 0, 127, 0.42);
            box-shadow: 0 0 24px rgba(255, 0, 127, 0.8);
        }

        .gas-btn.active {
            background: rgba(0, 255, 136, 0.38);
            box-shadow: 0 0 24px rgba(0, 255, 136, 0.75);
        }

        .nitro-btn.active {
            background: rgba(255, 230, 0, 0.45);
            box-shadow: 0 0 28px rgba(255, 230, 0, 0.9);
        }

        .touch-btn span {
            font-family: 'Orbitron', sans-serif;
            font-size: 0.72rem;
            font-weight: 700;
            letter-spacing: 1px;
            margin-top: 4px;
            opacity: 0.92;
            pointer-events: none;
        }

        /* ================= MENÜS & OVERLAYS ================= */
        .overlay-screen {
            position: absolute;
            inset: 0;
            background: radial-gradient(circle at center, rgba(18, 8, 42, 0.86) 0%, rgba(4, 2, 12, 0.95) 100%);
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 24px;
            z-index: 9000;
            text-align: center;
            overflow-y: auto;
            pointer-events: auto;
        }

        #start-overlay {
            z-index: 9999;
            pointer-events: auto;
        }

        .hidden {
            display: none !important;
        }

        .game-title {
            font-family: 'Orbitron', sans-serif;
            font-size: clamp(2.1rem, 6.2vw, 4.6rem);
            font-weight: 900;
            letter-spacing: 3px;
            background: linear-gradient(180deg, #ffffff 15%, var(--neon-cyan) 55%, var(--neon-pink) 95%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            filter: drop-shadow(0 0 18px rgba(0, 243, 255, 0.45));
            margin-bottom: 6px;
        }

        .game-subtitle {
            font-size: clamp(0.9rem, 2.2vw, 1.2rem);
            color: var(--neon-pink);
            letter-spacing: 4px;
            text-transform: uppercase;
            font-weight: 700;
            margin-bottom: 20px;
            text-shadow: 0 0 10px rgba(255, 0, 127, 0.6);
        }

        .track-selector {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(215px, 1fr));
            gap: 14px;
            width: 100%;
            max-width: 760px;
            margin-bottom: 22px;
        }

        .track-card {
            background: rgba(18, 12, 42, 0.85);
            border: 2px solid rgba(255, 255, 255, 0.16);
            border-radius: 16px;
            padding: 16px;
            cursor: pointer;
            touch-action: manipulation;
            transition: all 0.2s ease;
            text-align: left;
            position: relative;
        }

        .track-card:hover,
        .track-card.selected {
            border-color: var(--neon-cyan);
            background: rgba(0, 243, 255, 0.14);
            box-shadow: 0 0 22px rgba(0, 243, 255, 0.35);
            transform: translateY(-2px);
        }

        .track-card.selected::after {
            content: "GEWÄHLT";
            position: absolute;
            top: 12px;
            right: 12px;
            background: var(--neon-cyan);
            color: #05020e;
            font-family: 'Orbitron', sans-serif;
            font-size: 0.65rem;
            font-weight: 900;
            padding: 3px 8px;
            border-radius: 6px;
        }

        .track-title {
            font-family: 'Orbitron', sans-serif;
            font-size: 1.1rem;
            font-weight: 700;
            color: #fff;
            margin-bottom: 5px;
            pointer-events: none;
        }

        .track-desc {
            font-size: 0.9rem;
            color: #cbd5e1;
            margin-bottom: 8px;
            line-height: 1.35;
            pointer-events: none;
        }

        .track-meta {
            font-size: 0.8rem;
            color: var(--neon-yellow);
            font-weight: 700;
            pointer-events: none;
        }

        .primary-btn {
            font-family: 'Orbitron', sans-serif;
            font-size: 1.2rem;
            font-weight: 900;
            letter-spacing: 2px;
            color: #05020e;
            background: linear-gradient(90deg, var(--neon-cyan), #72f8ff);
            border: none;
            border-radius: 16px;
            padding: 17px 42px;
            min-height: 56px;
            cursor: pointer;
            touch-action: manipulation;
            pointer-events: auto;
            box-shadow: 0 0 25px rgba(0, 243, 255, 0.55);
            transition: transform 0.12s ease;
            margin: 6px;
            position: relative;
            z-index: 10000;
        }

        .primary-btn span {
            pointer-events: none;
        }

        .primary-btn:active {
            transform: scale(0.95);
        }

        .secondary-btn {
            font-family: 'Orbitron', sans-serif;
            font-size: 1rem;
            font-weight: 700;
            letter-spacing: 1.5px;
            color: #fff;
            background: rgba(255, 0, 127, 0.22);
            border: 2px solid var(--neon-pink);
            border-radius: 14px;
            padding: 14px 30px;
            min-height: 52px;
            cursor: pointer;
            touch-action: manipulation;
            pointer-events: auto;
            box-shadow: 0 0 15px rgba(255, 0, 127, 0.35);
            transition: transform 0.12s ease;
            margin: 6px;
            position: relative;
            z-index: 10000;
        }

        .secondary-btn span {
            pointer-events: none;
        }

        .secondary-btn:active {
            transform: scale(0.95);
        }

        .controls-hint {
            margin-top: 16px;
            font-size: 0.9rem;
            color: #94a3b8;
            max-width: 660px;
            line-height: 1.5;
        }

        .status-banner {
            margin-top: 12px;
            background: rgba(0, 243, 255, 0.12);
            border: 1.5px solid rgba(0, 243, 255, 0.55);
            color: #e0faff;
            border-radius: 12px;
            padding: 8px 16px;
            max-width: 580px;
            font-size: 0.85rem;
            line-height: 1.4;
        }

        .result-stats {
            background: rgba(15, 10, 36, 0.88);
            border: 1.5px solid var(--neon-pink);
            border-radius: 16px;
            padding: 18px 28px;
            margin: 16px 0 24px;
            min-width: 300px;
            box-shadow: 0 0 25px rgba(255, 0, 127, 0.3);
        }

        .stat-row {
            display: flex;
            justify-content: space-between;
            gap: 24px;
            padding: 8px 0;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            font-size: 1.1rem;
        }

        .stat-row:last-child {
            border-bottom: none;
        }

        .stat-val {
            font-family: 'Orbitron', sans-serif;
            color: var(--neon-cyan);
            font-weight: 700;
        }

        @media (orientation: portrait) {
            .rivals-panel {
                display: none;
            }
            #keyboard-hud-hint {
                display: none;
            }
            .hud-panel {
                padding: 5px 9px;
            }
            .hud-value {
                font-size: 1.1rem;
            }
            .nitro-wrapper {
                min-width: 110px;
            }
            .steer-btn {
                width: 74px;
                height: 74px;
            }
            .pedal-btn {
                width: 70px;
                height: 86px;
            }
            .nitro-btn {
                width: 66px;
                height: 66px;
            }
            .control-cluster {
                gap: 8px;
            }
        }

        #vignette { position:absolute; inset:0; pointer-events:none; z-index:6; opacity:0; transition:opacity .3s;
            background: radial-gradient(ellipse at center, transparent 52%, rgba(5,2,14,0.85) 100%); }
        #vignette.nitro { background: radial-gradient(ellipse at center, transparent 45%, rgba(0,243,255,0.38) 100%); }

        #start-overlay::before, #main-menu::before { content:""; position:absolute; inset:0; z-index:0; opacity:.55;
            background-image: linear-gradient(rgba(255,0,127,.28) 1px, transparent 1px), linear-gradient(90deg, rgba(0,243,255,.22) 1px, transparent 1px);
            background-size: 54px 54px; transform: perspective(500px) rotateX(62deg) scale(2.4); transform-origin: 50% 100%;
            animation: gridMove 2.4s linear infinite; mask-image: linear-gradient(to top, #000 10%, transparent 75%); -webkit-mask-image: linear-gradient(to top, #000 10%, transparent 75%); }
        @keyframes gridMove { to { background-position: 0 54px, 54px 0; } }
        #start-overlay > *, #main-menu > * { position: relative; z-index: 1; }
        .overlay-screen::after { content:""; position:absolute; inset:0; pointer-events:none; z-index:0;
            background: repeating-linear-gradient(0deg, rgba(255,255,255,.035) 0, rgba(255,255,255,.035) 1px, transparent 1px, transparent 3px); }
        .game-title { animation: titlePulse 2.6s ease-in-out infinite alternate; }
        @keyframes titlePulse { from { filter: drop-shadow(0 0 10px rgba(0,243,255,.35)) drop-shadow(3px 0 0 rgba(255,0,127,.5)); }
                                to { filter: drop-shadow(0 0 28px rgba(0,243,255,.8)) drop-shadow(-3px 0 0 rgba(255,0,127,.6)); } }
        .track-card { backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px); overflow: hidden; }
        .track-card::before { content:""; position:absolute; left:0; top:0; bottom:0; width:4px; background: linear-gradient(var(--neon-cyan), var(--neon-pink)); }
        .track-card:nth-child(2)::before { background: linear-gradient(#ffe600, #ff3366); }
        .track-card:nth-child(3)::before { background: linear-gradient(#9d00ff, #00f3ff); }
        .primary-btn { background-size: 200% 100%; animation: btnShine 2.2s linear infinite; }
        @keyframes btnShine { 0% { background-position: 0% 0; } 100% { background-position: 200% 0; } }
        .primary-btn { background-image: linear-gradient(100deg, #00f3ff 0%, #b5fbff 25%, #00f3ff 50%, #00f3ff 100%); }
        .hud-panel { clip-path: polygon(0 0, calc(100% - 10px) 0, 100% 10px, 100% 100%, 10px 100%, 0 calc(100% - 10px)); border-radius: 4px; }
        .hud-value { background: linear-gradient(180deg,#fff,#9ef9ff); -webkit-background-clip:text; -webkit-text-fill-color:transparent; }
        #race-banner { text-shadow: 0 0 15px var(--neon-pink), 0 0 35px var(--neon-cyan), 0 0 70px var(--neon-purple); letter-spacing: 6px; }
        #nitro-flash { position:absolute; inset:0; pointer-events:none; z-index:7; opacity:0;
            background: radial-gradient(circle at 50% 62%, rgba(190,250,255,.6), rgba(0,243,255,.18) 40%, transparent 65%); }
        #nitro-flash.go { animation: nflash .5s ease-out; }
        @keyframes nflash { 0% { opacity: 1; } 100% { opacity: 0; } }
        #start-overlay, #main-menu { justify-content: flex-start; touch-action: pan-y; }
        #start-overlay > :first-child, #main-menu > :first-child { margin-top: auto; }
        #start-overlay > :last-child, #main-menu > :last-child { margin-bottom: auto; }
        .credit-bar { font-family:'Orbitron',sans-serif; font-weight:900; font-size:1.1rem; color:var(--neon-yellow); text-shadow:0 0 12px rgba(255,230,0,.6); margin-bottom:8px; }
        .tab-row { display:flex; gap:8px; margin-bottom:12px; }
        .tab-btn { font-family:'Orbitron',sans-serif; font-weight:700; letter-spacing:1.5px; font-size:.85rem; color:#cbd5e1; background:rgba(18,12,42,.85); border:2px solid rgba(255,255,255,.18); border-radius:12px; padding:10px 22px; min-height:44px; cursor:pointer; touch-action:manipulation; }
        .tab-btn.active { color:#05020e; background:var(--neon-cyan); border-color:var(--neon-cyan); box-shadow:0 0 18px rgba(0,243,255,.5); }
        .menu-panel { width:100%; max-width:820px; margin-bottom:14px; }
        .menu-panel .track-selector { margin-bottom:12px; }
        .track-card.locked { opacity:.5; filter:grayscale(.6); }
        .menu-label { font-family:'Orbitron',sans-serif; font-size:.75rem; letter-spacing:2px; color:var(--neon-pink); margin:6px 0; }
        .diff-row { display:flex; gap:8px; justify-content:center; flex-wrap:wrap; }
        .diff-btn { font-family:'Orbitron',sans-serif; font-weight:700; font-size:.85rem; color:#fff; background:rgba(18,12,42,.85); border:2px solid rgba(255,255,255,.18); border-radius:12px; padding:8px 16px; min-height:48px; cursor:pointer; touch-action:manipulation; display:flex; flex-direction:column; align-items:center; }
        .diff-btn small { font-size:.6rem; color:var(--neon-yellow); margin-top:2px; }
