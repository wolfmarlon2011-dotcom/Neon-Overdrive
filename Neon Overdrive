        var gm1 = new THREE.MeshBasicMaterial({ color: c1, transparent: true, opacity: 0.22, blending: THREE.AdditiveBlending, depthWrite: false });
        var gm2 = new THREE.MeshBasicMaterial({ color: c2, transparent: true, opacity: 0.22, blending: THREE.AdditiveBlending, depthWrite: false });
