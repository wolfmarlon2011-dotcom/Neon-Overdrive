    // =========================================================================
    // 10. HAUPT-RENDER-LOOP (Nahtloser 2D -> 3D Wechsel ohne Start-Wartezeit)
    // =========================================================================
    var lastTime = 0;
    var warpIntensity = 0;
    var loopRunning = false;

    function ensureLoopRunning() {
        if (!loopRunning) {
            loopRunning = true;
            requestAnimationFrame(animate);
        }
    }

    function animate(timestamp) {
        loopRunning = true;
        requestAnimationFrame(animate);
        try {
            if (!lastTime) lastTime = timestamp;
            var dt = Math.min(0.05, Math.max(0.001, (timestamp - lastTime) / 1000));
            lastTime = timestamp;

            // Sobald Three.js asynchron geladen wurde, nahtlos auf 3D umschalten
            if (!useThree3D && window.THREE && typeof window.THREE.WebGLRenderer === 'function') {
                if (initThreeEngine()) {
                    buildTrackData(selectedTrackIndex, true);
                    spawnAIRacers(selectedTrackIndex);
                    handleResize();
                    if (gameState === 'RACING' || gameState === 'PAUSED') {
                        placePlayerOnTrack(player.progress, player.lateral, player.headingAngle);
                        player.vx = Math.sin(player.yaw) * player.speed;
                        player.vz = Math.cos(player.yaw) * player.speed;
                    }
                }
            }

            shaderUniforms.uTime.value = timestamp * 0.001;
            shaderUniforms.uSpeed.value = player.speed / player.maxSpeed;
            var targetNitroShader = player.nitroActive ? 1.0 : 0.0;
            shaderUniforms.uNitro.value += (targetNitroShader - shaderUniforms.uNitro.value) * Math.min(1, 8 * dt);

            if (gameState === 'MENU') {
                player.progress = (player.progress + 38 * dt) % trackLength;
                player.lateral = Math.sin(timestamp * 0.0007) * 4.5;
                player.headingAngle = 0;
                for (var aiIdx = 0; aiIdx < aiRacers.length; aiIdx++) {
                    aiRacers[aiIdx].progress = (aiRacers[aiIdx].progress + (36 + aiIdx * 1.5) * dt) % trackLength;
                }
                placePlayerOnTrack(player.progress, player.lateral, 0);
                updateVisualTransforms(dt, false, 0);
            } else if (gameState === 'RACING') {
                updateRaceLogic(dt * cheats.time);
            } else if (gameState === 'COUNTDOWN') {
                countdownTimer -= dt;
                var cdNum = Math.ceil(countdownTimer);
                if (cdNum >= 1 && cdNum !== countdownShown) {
                    countdownShown = cdNum;
                    showBanner(String(cdNum), 950);
                    sound.playBeep(520, 0.15, 'triangle');
                }
                if (countdownTimer <= 0) {
                    gameState = 'RACING';
                    var goT = performance.now();
                    player.raceStartTime = goT;
                    player.lapStartTime = goT;
                    showBanner('LOS!', 900);
                    sound.playBeep(988, 0.3, 'triangle');
                }
                updateVisualTransforms(dt, false, 0);
                updateHUD(0);
            } else {
                updateVisualTransforms(dt, false, player.speed / player.maxSpeed);
            }

            if (useThree3D && animatedGates.length > 0) {
                for (var i = 0; i < animatedGates.length; i++) {
                    animatedGates[i].rotation.z = Math.sin(timestamp * 0.002 + i) * 0.03;
                }
            }

            var targetWarp = (gameState === 'RACING' && player.nitroActive) ? 1.0 : 0.0;
            warpIntensity += (targetWarp - warpIntensity) * Math.min(1, 7 * dt);
            if (warpGl && warpProgram) {
                if (warpIntensity > 0.01) {
                    ui.warpCanvas.style.opacity = '1';
                    warpGl.clearColor(0, 0, 0, 0);
                    warpGl.clear(warpGl.COLOR_BUFFER_BIT);
                    warpGl.uniform1f(warpUniformTime, timestamp * 0.001);
                    warpGl.uniform1f(warpUniformIntensity, warpIntensity);
                    warpGl.drawArrays(warpGl.TRIANGLE_STRIP, 0, 4);
                } else {
                    ui.warpCanvas.style.opacity = '0';
                }
            }

            if (useThree3D && skyGroup && camera) skyGroup.position.copy(camera.position);
            if (!vignetteEl) vignetteEl = document.getElementById('vignette');
            if (vignetteEl) {
                var racingNow = gameState === 'RACING';
                vignetteEl.style.opacity = racingNow ? String(0.3 + 0.55 * Math.min(1, player.speed / player.maxSpeed) + (player.nitroActive ? 0.15 : 0)) : '0';
                vignetteEl.classList.toggle('nitro', player.nitroActive);
            }

            if (useThree3D && renderer && scene && camera) {
                renderer.render(scene, camera);
            } else {
                render2DFallback(lastScraping);
            }
        } catch (loopErr) {}
    }

    function boot() {
        applyCarStats();
        applySettings();
        renderMenu();
        renderMainMenu();
        handleResize();
        initWarpShader();
        initThreeEngine();
        buildTrackData(selectedTrackIndex, true);
        spawnAIRacers(selectedTrackIndex);
        ensureLoopRunning();
    }

    if (document.readyState === 'complete' || document.readyState === 'interactive') {
        boot();
    } else {
        document.addEventListener('DOMContentLoaded', boot);
    }
})();
</script>
</body>
</html>
