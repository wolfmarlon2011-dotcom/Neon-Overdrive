                '    float sl = step(0.988, hash(vec2(floor(u * 70.0), floor(v * 5.0 - uTime * uSpeed * 7.0))));',
                '    col += uCurb1 * sl * (0.12 + 0.3 * uSpeed) * smoothstep(0.08, 0.2, edgeDist);',
                '    col += uCurb2 * 0.05 * smoothstep(0.35, 0.0, abs(u - 0.5)) * (0.6 + 0.4 * sin(v * 0.6 - uTime * 2.0));',
                '    vec3 viewDir = normalize(cameraPosition - vWorldPos);',
                '    float fresnel = pow(1.0 - max(dot(viewDir, vec3(0.0, 1.0, 0.0)), 0.0), 3.0);',
                '    col += mix(uCurb1, uCurb2, u) * fresnel * 0.16;',
                '    vec3 refl = reflect(-viewDir, vec3(0.0, 1.0, 0.0));',
                '    float wet = 0.55 + 0.45 * sin(u * 23.0 + v * 0.7) * sin(v * 1.3);',
                '    vec3 rcol = skyColor(refl) + uCurb1 * smoothstep(0.30, 0.0, abs(u - 0.06)) * 0.8 + uCurb2 * smoothstep(0.30, 0.0, abs(u - 0.94)) * 0.8;',
                '    col += rcol * (fresnel * 0.9 + 0.04) * wet;',
                '    float dist = length(cameraPosition - vWorldPos);',
                '    float fogFactor = 1.0 - exp(-uFogDensity * uFogDensity * dist * dist);',
                '    col = mix(col, uFogColor, clamp(fogFactor, 0.0, 1.0));',
                '    gl_FragColor = vec4(col, 1.0);',
                '}'
            ].join('\n'),
            side: THREE.DoubleSide
        });
    }

    // SHADER 3: Perspektivisches Terrain-Gitter
    function createTerrainGridShaderMaterial(cfg) {
        return new THREE.ShaderMaterial({
            uniforms: {
                uTime: shaderUniforms.uTime,
                uGridColor1: { value: new THREE.Color(cfg.gridColor1) },
                uGridColor2: { value: new THREE.Color(cfg.gridColor2) },
                uFogColor: shaderUniforms.uFogColor,
                uFogDensity: shaderUniforms.uFogDensity,
                uNitro: shaderUniforms.uNitro
            },
            vertexShader: [
                'varying vec3 vWorldPos;',
                'void main() {',
                '    vec4 worldPos = modelMatrix * vec4(position, 1.0);',
                '    vWorldPos = worldPos.xyz;',
                '    gl_Position = projectionMatrix * viewMatrix * worldPos;',
                '}'
            ].join('\n'),
            fragmentShader: [
                'uniform float uTime;',
                'uniform vec3 uGridColor1;',
                'uniform vec3 uGridColor2;',
                'uniform vec3 uFogColor;',
                'uniform float uFogDensity;',
                'uniform float uNitro;',
                'varying vec3 vWorldPos;',
                'void main() {',
                '    vec2 coord = vWorldPos.xz / 24.0;',
                '    vec2 grid = abs(fract(coord - 0.5) - 0.5) / max(fwidth(coord), vec2(0.0001));',
                '    float line = min(grid.x, grid.y);',
                '    float gridMask = 1.0 - min(line, 1.0);',
                '    float pulse = 0.65 + 0.35 * sin(vWorldPos.z * 0.015 + uTime * 2.5);',
                '    vec3 lineCol = mix(uGridColor1, vec3(0.0, 0.95, 1.0), uNitro * 0.25) * pulse;',
                '    vec3 col = mix(uGridColor2 * 0.45, lineCol, gridMask * 0.82);',
                '    float dist = length(cameraPosition - vWorldPos);',
                '    float fogFactor = 1.0 - exp(-uFogDensity * uFogDensity * dist * dist * 1.15);',
                '    col = mix(col, uFogColor, clamp(fogFactor, 0.0, 1.0));',
                '    gl_FragColor = vec4(col, 1.0);',
                '}'
            ].join('\n'),
            extensions: { derivatives: true }
        });
    }

    // SHADER 4: Fahrzeug-Karosserie Metallic + Fresnel Rim-Light
    function createCarBodyShaderMaterial(rimHex, baseHex) {
        return new THREE.ShaderMaterial({
            uniforms: {
                uTime: shaderUniforms.uTime,
                uBaseColor: { value: new THREE.Color(baseHex === undefined ? 0x0f0a22 : baseHex) },
                uSkyTop: shaderUniforms.uSkyTop,
                uSkyHorizon: shaderUniforms.uSkyHorizon,
                uSunTopC: shaderUniforms.uSunTop,
                uSunBotC: shaderUniforms.uSunBottom,
                uRimColor: { value: new THREE.Color(rimHex) },
                uLightDir: { value: new THREE.Vector3(0.4, 0.85, 0.35).normalize() }
            },
            vertexShader: [
                'varying vec3 vNormalWorld;',
                'varying vec3 vWorldPos;',
                'void main() {',
                '    vec4 worldPos = modelMatrix * vec4(position, 1.0);',
                '    vWorldPos = worldPos.xyz;',
                '    vNormalWorld = normalize(mat3(modelMatrix) * normal);',
                '    gl_Position = projectionMatrix * viewMatrix * worldPos;',
                '}'
            ].join('\n'),
            fragmentShader: [
                'uniform float uTime;',
                'uniform vec3 uBaseColor;',
                'uniform vec3 uRimColor;',
                'uniform vec3 uLightDir;',
                SKY_GLSL,
                'varying vec3 vNormalWorld;',
                'varying vec3 vWorldPos;',
                'void main() {',
                '    vec3 N = normalize(vNormalWorld);',
                '    vec3 V = normalize(cameraPosition - vWorldPos);',
                '    float diff = max(dot(N, uLightDir), 0.18);',
                '    vec3 H = normalize(uLightDir + V);',
                '    float spec = pow(max(dot(N, H), 0.0), 72.0);',
                '    vec3 R = reflect(-V, N);',
                '    float sky = smoothstep(-0.25, 0.95, R.y);',
                '    float horizonBand = smoothstep(0.12, 0.0, abs(R.y - 0.05));',
                '    float fresnel = pow(1.0 - max(dot(V, N), 0.0), 2.6);',
                '    float pulse = 0.85 + 0.15 * sin(uTime * 4.0);',
                '    vec3 col = mix(uBaseColor, uRimColor * 0.22, 0.14) * diff + vec3(0.9) * spec + uRimColor * fresnel * 1.25 * pulse;',
                '    col += skyColor(R) * (0.28 + 0.9 * fresnel) + vec3(1.0, 0.35, 0.8) * horizonBand * 0.25;',
                '    gl_FragColor = vec4(col, 1.0);',
                '}'
            ].join('\n')
        });
    }

    function createCheckerTexture() {
        var canvas = document.createElement('canvas');
        canvas.width = 256;
        canvas.height = 64;
        var c = canvas.getContext('2d');
        var size = 16;
        for (var y = 0; y < 4; y++) {
            for (var x = 0; x < 16; x++) {
                c.fillStyle = (x + y) % 2 === 0 ? '#ffffff' : '#090514';
                c.fillRect(x * size, y * size, size, size);
            }
        }
        var tex = new THREE.CanvasTexture(canvas);
        tex.wrapS = THREE.RepeatWrapping;
        tex.wrapT = THREE.RepeatWrapping;
        return tex;
    }

