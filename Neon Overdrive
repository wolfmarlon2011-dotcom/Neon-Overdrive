    var menuClick = function (e) {
        var t = e.target.closest ? e.target.closest('[data-act],[data-tab]') : null;
        if (!t) return;
        sound.init();
        if (t.dataset.tab) { menuTab = t.dataset.tab; confirmReset = -1; renderMenu(); return; }
        var act = t.dataset.act, i = parseInt(t.dataset.i, 10);
        if (act && act.indexOf('m-') === 0) { handleMainAction(act, i, t); return; }
        if (act === 'track') {
            if (!save.tracks[i]) {
                ui.statusBanner.textContent = 'Gesperrt — Quest: ' + lockHint('track', i);
                sound.playBeep(180, 0.12, 'sawtooth');
                return;
            }
            ui.statusBanner.textContent = 'Bereit zum Start — Tippe auf RENNEN STARTEN';
            selectedTrackIndex = i;
            save.track = i;
            initThreeEngine();
            buildTrackData(selectedTrackIndex, true);
            spawnAIRacers(selectedTrackIndex);
            sound.playBeep(520, 0.08, 'sine');
        } else if (act === 'diff') {
            save.diff = i;
            spawnAIRacers(selectedTrackIndex);
            sound.playBeep(440 + i * 80, 0.08, 'sine');
        } else if (act === 'car') {
            if (!save.cars[i]) {
                ui.statusBanner.textContent = 'Gesperrt — Quest: ' + lockHint('car', i);
                sound.playBeep(180, 0.12, 'sawtooth');
                return;
            }
            save.car = i;
            applyPlayerCar();
            sound.playBeep(600, 0.08, 'sine');
        } else if (act === 'slot-load') {
            writeSave();
            activeSlot = i;
            root = readSlot(i) || defaultRoot();
            confirmReset = -1;
            afterSaveChange();
            sound.playBeep(700, 0.1, 'triangle');
        } else if (act === 'slot-save') {
            try { window.localStorage.setItem(SLOT_PREFIX + i, JSON.stringify(root)); } catch (e) {}
            sound.playBeep(700, 0.1, 'triangle');
        } else if (act === 'slot-reset') {
            if (confirmReset !== i) { confirmReset = i; sound.playBeep(300, 0.12, 'sawtooth'); renderMenu(); return; }
            confirmReset = -1;
            if (i === activeSlot) {
                root = defaultRoot();
                afterSaveChange();
            } else {
                try { window.localStorage.removeItem(SLOT_PREFIX + i); } catch (e) {}
            }
            sound.playBeep(240, 0.2, 'sawtooth');
        } else if (act === 'upg') {
            var ci = parseInt(t.dataset.c, 10);
            var lvl = save.levels[save.car][ci];
            var cost = upgradeCost(save.car, lvl);
            if (lvl >= 5 || save.credits < cost) { sound.playBeep(180, 0.12, 'sawtooth'); return; }
            save.credits -= cost;
            save.levels[save.car][ci]++;
            applyCarStats();
            sound.playBeep(780, 0.14, 'triangle');
        }
        writeSave();
        renderMenu();
    };
