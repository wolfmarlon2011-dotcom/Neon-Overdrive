    function spawnAIRacers(trackIdx) {
        var cfg = TRACK_CONFIGS[trackIdx] || TRACK_CONFIGS[0];
        var aiDefs = [
            { name: 'VEX',   color: 0xff007f, accent: 0xff80bf, hexStr: '#ff007f', skill: 1.03, preferredLane: -6.5 },
            { name: 'KIRA',  color: 0xffe600, accent: 0xffffff, hexStr: '#ffe600', skill: 0.99, preferredLane: 6.5 },
            { name: 'ZERO',  color: 0x9d00ff, accent: 0x00f3ff, hexStr: '#9d00ff', skill: 0.96, preferredLane: -3.2 },
            { name: 'NOVA',  color: 0x00ff88, accent: 0xffffff, hexStr: '#00ff88', skill: 0.93, preferredLane: 3.2 },
            { name: 'BLITZ', color: 0xff5500, accent: 0xffe600, hexStr: '#ff5500', skill: 0.90, preferredLane: 0.0 }
        ];

        var reuseExisting = aiRacers.length === aiDefs.length;
        if (!reuseExisting && useThree3D && scene) {
            aiRacers.forEach(function (ai) {
                if (ai.visual && ai.visual.mesh) scene.remove(ai.visual.mesh);
            });
            aiRacers = [];
        }

        aiDefs.forEach(function (def, idx) {
            var startDist = (idx + 1) * 16 + 10;
            if (reuseExisting) {
                var existing = aiRacers[idx];
                if (!existing.visual && useThree3D && window.THREE && scene) {
                    existing.visual = makeAICarMesh(def.color, def.accent);
                    scene.add(existing.visual.mesh);
                }
                existing.progress = startDist;
                existing.totalDistance = startDist;
                existing.lateral = def.preferredLane;
                existing.targetLateral = def.preferredLane;
                existing.speed = 0;
                existing.baseMaxSpeed = cfg.aiBaseSpeed * def.skill * DIFFS[save.diff].ai * cheats.aiX;
                existing.laneTimer = 1.2 + idx * 0.65;
                existing.steerAngle = 0;
                existing.nitroActive = false;
            } else {
                var visual = null;
                if (useThree3D && window.THREE && scene) {
                    visual = makeAICarMesh(def.color, def.accent);
                    scene.add(visual.mesh);
                }
                aiRacers.push({
                    id: idx,
                    name: def.name,
                    colorHex: def.hexStr,
                    visual: visual,
                    progress: startDist,
                    totalDistance: startDist,
                    lateral: def.preferredLane,
                    targetLateral: def.preferredLane,
                    speed: 0,
                    baseMaxSpeed: cfg.aiBaseSpeed * def.skill * DIFFS[save.diff].ai * cheats.aiX,
                    laneTimer: 1.2 + idx * 0.65,
                    steerAngle: 0,
                    nitroActive: false
                });
            }
        });
    }

