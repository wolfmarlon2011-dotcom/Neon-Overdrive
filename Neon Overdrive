    function formatTime(ms) {
        if (ms === null || ms === undefined || isNaN(ms)) return '--:--.--';
        var totalSec = Math.max(0, ms / 1000);
        var mins = Math.floor(totalSec / 60);
        var secs = Math.floor(totalSec % 60);
        var hundredths = Math.floor((ms % 1000) / 10);
        return String(mins).padStart(2, '0') + ':' + String(secs).padStart(2, '0') + '.' + String(hundredths).padStart(2, '0');
    }

    function showBanner(text, durationMs) {
        if (!ui.banner) return;
        ui.banner.textContent = text;
        ui.banner.classList.add('show');
        if (bannerTimeout) clearTimeout(bannerTimeout);
        if (durationMs > 0) {
            bannerTimeout = setTimeout(function () {
                ui.banner.classList.remove('show');
            }, durationMs);
        }
    }

    function getStandings() {
        var entries = [
            { name: 'DU', totalDistance: player.totalDistance, isPlayer: true }
        ].concat(aiRacers.map(function (ai) {
            return { name: ai.name, totalDistance: ai.totalDistance, isPlayer: false };
        }));
        entries.sort(function (a, b) { return b.totalDistance - a.totalDistance; });
        return entries.map(function (entry, index) {
            return {
                name: entry.name,
                totalDistance: entry.totalDistance,
                isPlayer: entry.isPlayer,
                rank: index + 1
            };
        });
    }

