                'float hash(vec2 p) { return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453123); }',
                'void main() {',
                '    float side = 1.0 - abs(vN.y);',
                '    vec2 wc = vec2((vW.x + vW.z) / 4.5, vW.y / 5.5);',
                '    vec2 id = floor(wc);',
