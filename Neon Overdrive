    function buildEnvironmentProps(cfg) {
        var boxGeo = new THREE.BoxGeometry(1, 1, 1);
        var coneGeo = new THREE.ConeGeometry(1, 1, 4);
        var buildingMatDark = createBuildingShaderMaterial(cfg);
        var neonTrimMat1 = new THREE.MeshBasicMaterial({ color: 0x00f3ff });
        var neonTrimMat2 = new THREE.MeshBasicMaterial({ color: 0xff007f });

        for (var i = 0; i < 120; i++) {
            var u = i / 120;
            var frame = getFrameAtDistance(u * trackLength, null);
            var side = (i % 2 === 0) ? 1 : -1;
            var lateralDist = ROAD_HALF_WIDTH + 22 + ((i * 29) % 105);
            var pos = frame.point.clone().addScaledVector(frame.right, side * lateralDist);
            pos.y = cfg.flying ? -320 : -18;

            var tooClose = false;
            for (var s = 0; s < TRACK_SAMPLES; s += 12) {
                var pdx = pos.x - trackFrames.points[s].x, pdz = pos.z - trackFrames.points[s].z;
                if (pdx * pdx + pdz * pdz < 950) {
                    tooClose = true;
                    break;
                }
            }
            if (tooClose) continue;

            if (cfg.envType === 'canyon') {
                var radius = 16 + (i % 5) * 6;
                var height = 45 + (i % 7) * 18;
                var mountain = new THREE.Mesh(coneGeo, buildingMatDark);
                mountain.scale.set(radius, height, radius);
                mountain.position.set(pos.x, pos.y + height / 2, pos.z);
                worldGroup.add(mountain);
            } else {
                var w = 14 + (i % 4) * 5;
                var d = 14 + ((i + 2) % 4) * 5;
                var h = (cfg.flying ? 220 : 40) + (i % 9) * (cfg.flying ? 40 : 22);
                var tower = new THREE.Mesh(boxGeo, buildingMatDark);
                tower.scale.set(w, h, d);
                tower.position.set(pos.x, pos.y + h / 2, pos.z);
                worldGroup.add(tower);

                var trim = new THREE.Mesh(boxGeo, i % 3 === 0 ? neonTrimMat1 : neonTrimMat2);
                trim.scale.set(0.6, h * 0.88, d + 0.4);
                trim.position.set(pos.x, pos.y + h / 2, pos.z);
                worldGroup.add(trim);
            }
        }
    }

    function createHoloLaneMaterial(cfg) {
