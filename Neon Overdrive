        st.races++;
        st.topKmh = Math.max(st.topKmh, topKmh);
        st.driftBoosts += boosts;
        st.nitroTime += nitroSec;
        if (rank <= 3 && save.diff >= 1) st.podiums++;
        if (rank === 1 && save.diff >= 1) {
            st.wins++;
            st.trackWins[selectedTrackIndex]++;
            if (save.diff >= 2) st.hardWins++;
            if (save.diff >= 3) st.expertWins++;
        }
        var base = [300, 220, 160, 110, 70, 40][Math.min(5, rank - 1)];
        var earned = Math.round(base * (1 + 0.2 * selectedTrackIndex) * DIFFS[save.diff].rew * cheats.creditX);
        save.credits += earned;
        if (!save.best[selectedTrackIndex] || rank < save.best[selectedTrackIndex]) save.best[selectedTrackIndex] = rank;
        var msgs = [];
        QUESTS.forEach(function (q) {
            if (!save.done[q.id] && q.val(st) >= q.goal) {
                save.done[q.id] = true;
                save.credits += q.reward;
                var m = '✔ ' + q.text + ' (+' + q.reward + ' ◆)';
