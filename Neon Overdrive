            finishLineMesh.position.copy(startFrame.point).add(new THREE.Vector3(0, 0.08, 0));
            finishLineMesh.lookAt(startFrame.point.clone().add(startFrame.tangent));
            finishLineMesh.rotateX(-Math.PI / 2);
            finishLineMesh.visible = !cfg.flying;
            worldGroup.add(finishLineMesh);

            var archGroup = createNeonGate(ROAD_HALF_WIDTH + 1.5, 11, 0x00f3ff, 0xff007f, true);
            archGroup.position.copy(startFrame.point);
            archGroup.lookAt(startFrame.point.clone().add(startFrame.tangent));
            archGroup.visible = !cfg.flying;
            worldGroup.add(archGroup);

            for (var g = 1; g < (cfg.flying ? 1 : 14); g++) {
                var gFrame = getFrameAtDistance((g / 14) * trackLength, null);
                var gate = createNeonGate(ROAD_HALF_WIDTH + 1.2, 9.5, g % 2 === 0 ? 0x00f3ff : 0xff007f, 0x9d00ff, false);
                gate.position.copy(gFrame.point);
                gate.lookAt(gFrame.point.clone().add(gFrame.tangent));
                worldGroup.add(gate);
                animatedGates.push(gate);
            }

            var padPositions = [
                { dist: trackLength * 0.14, offset: -5.5 },
                { dist: trackLength * 0.28, offset: 5.5 },
                { dist: trackLength * 0.44, offset: 0.0 },
                { dist: trackLength * 0.62, offset: -6.0 },
                { dist: trackLength * 0.78, offset: 6.0 },
                { dist: trackLength * 0.91, offset: 0.0 }
            ];
            var padGeo = new THREE.PlaneGeometry(3.8, 9.5);
            var padMat = createPadShaderMaterial();

            padPositions.forEach(function (p) {
                var pFrame = getFrameAtDistance(p.dist, null);
                var padMesh = new THREE.Mesh(padGeo, padMat);
                var pPos = pFrame.point.clone().addScaledVector(pFrame.right, p.offset).add(new THREE.Vector3(0, cfg.flying ? 1.4 : 0.12, 0));
                padMesh.position.copy(pPos);
                padMesh.lookAt(pPos.clone().add(pFrame.tangent));
                padMesh.rotateX(-Math.PI / 2);
                worldGroup.add(padMesh);
                nitroPads.push({ dist: p.dist, offset: p.offset, mesh: padMesh });
            });

            var terrainGeo = new THREE.PlaneGeometry(3400, 3400, 1, 1);
            terrainGeo.rotateX(-Math.PI / 2);
            var terrainMesh = new THREE.Mesh(terrainGeo, createTerrainGridShaderMaterial(cfg));
            terrainMesh.position.set(220, cfg.flying ? -320 : -18, -150);
            worldGroup.add(terrainMesh);

            skyGroup = new THREE.Group();
            worldGroup.add(skyGroup);
            var domeMesh = new THREE.Mesh(new THREE.SphereGeometry(1350, 24, 14), createSkyDomeMaterial());
            domeMesh.renderOrder = -10;
            skyGroup.add(domeMesh);
            var sunMesh = new THREE.Mesh(new THREE.PlaneGeometry(480, 480), createSynthwaveSunShaderMaterial());
            sunMesh.position.set(260, 155, -1250);
            skyGroup.add(sunMesh);
            sunMesh.lookAt(0, 0, 0);

            var starPos = [];
            for (var stI = 0; stI < 900; stI++) {
                var stA = Math.random() * Math.PI * 2;
                var stE = 0.08 + Math.random() * 1.2;
                var stR = 1450;
                starPos.push(Math.cos(stA) * Math.cos(stE) * stR, Math.sin(stE) * stR, Math.sin(stA) * Math.cos(stE) * stR);
            }
            var starGeo = new THREE.BufferGeometry();
            starGeo.setAttribute('position', new THREE.Float32BufferAttribute(starPos, 3));
            skyGroup.add(new THREE.Points(starGeo, new THREE.PointsMaterial({ color: 0xffffff, size: 2.2, sizeAttenuation: false, fog: false })));

            buildEnvironmentProps(cfg);
            builtTrackIndex = trackIdx;
            buildMinimap();
        } else {
            trackLength = 1200;
            trackFrames = null;
            builtTrackIndex = trackIdx;
            buildMinimap();
            nitroPads = [
                { dist: trackLength * 0.2, offset: -4.0 },
                { dist: trackLength * 0.5, offset: 4.0 },
                { dist: trackLength * 0.8, offset: 0.0 }
            ];
        }
    }

    function getFrameAtDistance(dist, outFrame) {
        if (!useThree3D || !trackFrames || !window.THREE) {
            if (outFrame) {
                outFrame.point.x = 0; outFrame.point.y = 0; outFrame.point.z = -dist;
                outFrame.tangent.x = 0; outFrame.tangent.y = 0; outFrame.tangent.z = -1;
                outFrame.right.x = 1; outFrame.right.y = 0; outFrame.right.z = 0;
                outFrame.up.x = 0; outFrame.up.y = 1; outFrame.up.z = 0;
                return outFrame;
            }
            return {
                point: { x: 0, y: 0, z: -dist },
                tangent: { x: 0, y: 0, z: -1 },
                right: { x: 1, y: 0, z: 0 },
                up: { x: 0, y: 1, z: 0 }
            };
        }
        var wrapped = ((dist % trackLength) + trackLength) % trackLength;
        var exactIdx = (wrapped / trackLength) * TRACK_SAMPLES;
        var idx0 = Math.floor(exactIdx) % TRACK_SAMPLES;
        var idx1 = (idx0 + 1) % TRACK_SAMPLES;
        var alpha = exactIdx - Math.floor(exactIdx);

        if (outFrame) {
            outFrame.point.lerpVectors(trackFrames.points[idx0], trackFrames.points[idx1], alpha);
            outFrame.tangent.lerpVectors(trackFrames.tangents[idx0], trackFrames.tangents[idx1], alpha).normalize();
            outFrame.right.lerpVectors(trackFrames.rights[idx0], trackFrames.rights[idx1], alpha).normalize();
            outFrame.up.lerpVectors(trackFrames.ups[idx0], trackFrames.ups[idx1], alpha).normalize();
            return outFrame;
        }

        return {
            point: new THREE.Vector3().lerpVectors(trackFrames.points[idx0], trackFrames.points[idx1], alpha),
            tangent: new THREE.Vector3().lerpVectors(trackFrames.tangents[idx0], trackFrames.tangents[idx1], alpha).normalize(),
            right: new THREE.Vector3().lerpVectors(trackFrames.rights[idx0], trackFrames.rights[idx1], alpha).normalize(),
            up: new THREE.Vector3().lerpVectors(trackFrames.ups[idx0], trackFrames.ups[idx1], alpha).normalize()
        };
    }

    // Gelofteter Karosserie-Körper (abgerundete Querschnitte statt Boxen)
    function createCarBodyGeometry() {
        var secs = [
            [-2.35, 0.95, 0.38, 0.78], [-2.1, 1.08, 0.30, 0.88], [-1.2, 1.12, 0.28, 0.95], [0, 1.1, 0.28, 0.92],
            [1.1, 1.05, 0.28, 0.80], [2.0, 0.95, 0.30, 0.58], [2.45, 0.86, 0.32, 0.54], [2.78, 0.7, 0.35, 0.5]
        ];
        var seg = 16, pos = [], idx = [], ex = 0.38;
        secs.forEach(function (sc) {
            var cy = (sc[2] + sc[3]) / 2, hy = (sc[3] - sc[2]) / 2;
            for (var k = 0; k < seg; k++) {
                var a = (k / seg) * Math.PI * 2, c = Math.cos(a), sn = Math.sin(a);
                pos.push(
                    (c < 0 ? -1 : 1) * Math.pow(Math.abs(c), ex) * sc[1],
                    cy + (sn < 0 ? -1 : 1) * Math.pow(Math.abs(sn), ex) * hy,
                    sc[0]
                );
            }
        });
        for (var i = 0; i < secs.length - 1; i++) {
            for (var k2 = 0; k2 < seg; k2++) {
                var a0 = i * seg + k2, b0 = i * seg + (k2 + 1) % seg;
                var c0 = (i + 1) * seg + k2, d0 = (i + 1) * seg + (k2 + 1) % seg;
                idx.push(a0, b0, c0, b0, d0, c0);
            }
        }
        var last = secs.length - 1;
        pos.push(0, (secs[last][2] + secs[last][3]) / 2, secs[last][0]);
        var frontC = pos.length / 3 - 1;
        pos.push(0, (secs[0][2] + secs[0][3]) / 2, secs[0][0]);
        var rearC = pos.length / 3 - 1;
        for (var k3 = 0; k3 < seg; k3++) {
            idx.push(frontC, last * seg + k3, last * seg + (k3 + 1) % seg);
            idx.push(rearC, (k3 + 1) % seg, k3);
        }
        var g = new THREE.BufferGeometry();
        g.setAttribute('position', new THREE.Float32BufferAttribute(pos, 3));
        g.setIndex(idx);
        g.computeVertexNormals();
        return g;
    }

