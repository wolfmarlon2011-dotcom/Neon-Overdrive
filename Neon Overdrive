        '    float h = clamp(d.y, -0.2, 1.0);',
        '    vec3 c = mix(uSkyHorizon, uSkyTop, smoothstep(0.0, 0.75, h));',
        '    c += uSunBotC * 0.35 * exp(-abs(d.y) * 9.0);',
        '    vec3 sd = normalize(vec3(0.2, 0.12, -1.0));',
