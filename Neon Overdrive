    function initWarpShader() {
        try {
            warpGl = ui.warpCanvas.getContext('webgl', { alpha: true, antialias: true }) ||
                     ui.warpCanvas.getContext('experimental-webgl', { alpha: true });
            if (!warpGl) return;

            var vsSrc = [
                'attribute vec2 aPos;',
                'varying vec2 vUv;',
                'void main() {',
                '    vUv = aPos * 0.5 + 0.5;',
                '    gl_Position = vec4(aPos, 0.0, 1.0);',
                '}'
            ].join('\n');

            var fsSrc = [
                'precision mediump float;',
                'uniform float uTime;',
                'uniform float uIntensity;',
                'varying vec2 vUv;',
                'float hash(float n) { return fract(sin(n) * 43758.5453123); }',
                'void main() {',
                '    if (uIntensity <= 0.01) discard;',
                '    float edgeDist = min(vUv.x, 1.0 - vUv.x);',
                '    float sideMask = 1.0 - smoothstep(0.0, 0.14, edgeDist);',
                '    if (sideMask <= 0.01) discard;',
                '    float band = floor(vUv.x * 48.0);',
                '    float rnd = hash(band);',
                '    float streak = fract(vUv.y * 1.45 + uTime * (2.6 + rnd * 1.6) + rnd * 7.0);',
                '    float lineMask = smoothstep(0.68, 0.97, streak) * step(0.45, rnd);',
                '    vec3 col = mix(vec3(0.18, 0.88, 1.0), vec3(0.88, 0.96, 1.0), rnd);',
                '    float alpha = lineMask * sideMask * uIntensity * 0.34;',
                '    gl_FragColor = vec4(col, alpha);',
                '}'
            ].join('\n');

            var compile = function (type, src) {
                var s = warpGl.createShader(type);
                warpGl.shaderSource(s, src);
                warpGl.compileShader(s);
                return s;
            };

            warpProgram = warpGl.createProgram();
            warpGl.attachShader(warpProgram, compile(warpGl.VERTEX_SHADER, vsSrc));
            warpGl.attachShader(warpProgram, compile(warpGl.FRAGMENT_SHADER, fsSrc));
            warpGl.linkProgram(warpProgram);
            warpGl.useProgram(warpProgram);

            var buf = warpGl.createBuffer();
            warpGl.bindBuffer(warpGl.ARRAY_BUFFER, buf);
            warpGl.bufferData(warpGl.ARRAY_BUFFER, new Float32Array([-1, -1, 1, -1, -1, 1, 1, 1]), warpGl.STATIC_DRAW);

            var aPos = warpGl.getAttribLocation(warpProgram, 'aPos');
            warpGl.enableVertexAttribArray(aPos);
            warpGl.vertexAttribPointer(aPos, 2, warpGl.FLOAT, false, 0, 0);

            warpUniformTime = warpGl.getUniformLocation(warpProgram, 'uTime');
            warpUniformIntensity = warpGl.getUniformLocation(warpProgram, 'uIntensity');
        } catch (e) {
            warpGl = null;
        }
    }

