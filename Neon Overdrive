    // ===== MINIMAP: ganze Strecke von oben, Ziellinie, Spieler & Gegner =====
    var miniBase = null, miniInfo = null, miniCanvas = null, miniCtx = null;
    function buildMinimap() {
        miniCanvas = document.getElementById('minimap');
        if (!miniCanvas) return;
        miniCtx = miniCanvas.getContext('2d');
        var S = miniCanvas.width, pad = 20, pts = [], i;
        if (trackFrames) {
            for (i = 0; i < TRACK_SAMPLES; i += 4) pts.push(trackFrames.points[i]);
        } else {
            pts = [{ x: 0, z: 0 }, { x: 0, z: -trackLength }];
        }
        var minX = Infinity, maxX = -Infinity, minZ = Infinity, maxZ = -Infinity;
        pts.forEach(function (q) {
            if (q.x < minX) minX = q.x; if (q.x > maxX) maxX = q.x;
            if (q.z < minZ) minZ = q.z; if (q.z > maxZ) maxZ = q.z;
        });
        var sc = (S - 2 * pad) / Math.max(maxX - minX, maxZ - minZ, 1);
        miniInfo = { S: S, sc: sc, cx: (minX + maxX) / 2, cz: (minZ + maxZ) / 2 };
        var base = document.createElement('canvas');
        base.width = base.height = S;
        var c = base.getContext('2d');
        c.lineJoin = 'round';
        c.lineCap = 'round';
        function tracePath() {
            c.beginPath();
            pts.forEach(function (q, k) {
                var mx = S / 2 + (q.x - miniInfo.cx) * sc, my = S / 2 + (q.z - miniInfo.cz) * sc;
                if (k === 0) c.moveTo(mx, my); else c.lineTo(mx, my);
            });
            if (trackFrames) c.closePath();
        }
        tracePath();
        c.strokeStyle = 'rgba(0,243,255,0.22)';
        c.lineWidth = 16;
        c.stroke();
        tracePath();
        c.strokeStyle = 'rgba(190,250,255,0.95)';
        c.lineWidth = 5;
        c.stroke();
        miniBase = base;
    }

    function drawMinimap() {
        if (!miniCtx || !miniBase || !miniInfo) return;
        var c = miniCtx, S = miniInfo.S, sc = miniInfo.sc;
        function mx(x) { return S / 2 + (x - miniInfo.cx) * sc; }
        function my(z) { return S / 2 + (z - miniInfo.cz) * sc; }
        c.clearRect(0, 0, S, S);
        c.drawImage(miniBase, 0, 0);

        // Ziellinie (Schachbrett quer zur Strecke)
        var p0x = 0, p0z = 0, r0x = 1, r0z = 0;
        if (trackFrames) {
            p0x = trackFrames.points[0].x; p0z = trackFrames.points[0].z;
            r0x = trackFrames.rights[0].x; r0z = trackFrames.rights[0].z;
        }
        var hw = Math.max(ROAD_HALF_WIDTH * sc, 9);
        var ux = r0x, uy = r0z;
        var ulen = Math.sqrt(ux * ux + uy * uy) || 1;
        ux /= ulen; uy /= ulen;
        var cx0 = mx(p0x), cy0 = my(p0z);
        c.lineCap = 'butt';
        c.lineWidth = 6;
        for (var k = 0; k < 6; k++) {
            var t0 = -1 + k / 3, t1 = -1 + (k + 1) / 3;
            c.strokeStyle = (k % 2 === 0) ? '#ffffff' : '#05020e';
            c.beginPath();
            c.moveTo(cx0 + ux * hw * t0, cy0 + uy * hw * t0);
            c.lineTo(cx0 + ux * hw * t1, cy0 + uy * hw * t1);
            c.stroke();
        }

        // Gegner
        for (var a = 0; a < aiRacers.length; a++) {
            var ai = aiRacers[a], ax, az;
            if (trackFrames) {
                var ix = Math.floor(ai.progress / trackLength * TRACK_SAMPLES) % TRACK_SAMPLES;
                ax = trackFrames.points[ix].x + trackFrames.rights[ix].x * ai.lateral;
                az = trackFrames.points[ix].z + trackFrames.rights[ix].z * ai.lateral;
            } else {
                ax = ai.lateral; az = -ai.progress;
            }
            c.beginPath();
            c.arc(mx(ax), my(az), 7, 0, Math.PI * 2);
            c.fillStyle = ai.colorHex || '#ff007f';
            c.fill();
            c.lineWidth = 2;
            c.strokeStyle = '#05020e';
            c.stroke();
        }

        // Spieler: Pfeil in Fahrtrichtung
        var px = mx(player.wx), py = my(player.wz);
        var fx = Math.sin(player.yaw), fz = Math.cos(player.yaw);
        c.beginPath();
        c.moveTo(px + fx * 13, py + fz * 13);
        c.lineTo(px - fx * 8 - fz * 8, py - fz * 8 + fx * 8);
        c.lineTo(px - fx * 8 + fz * 8, py - fz * 8 - fx * 8);
        c.closePath();
        c.fillStyle = '#00f3ff';
        c.fill();
        c.lineWidth = 3;
        c.strokeStyle = '#ffffff';
        c.stroke();
    }

    function buildTrackData(trackIdx, forceRebuild) {
        var cfg = TRACK_CONFIGS[trackIdx] || TRACK_CONFIGS[0];
        if (!forceRebuild && builtTrackIndex === trackIdx && trackFrames && trackFrames.points.length > 0) {
            return;
        }
        nitroPads = [];
        animatedGates = [];
        flyRings = [];

        if (useThree3D && window.THREE && scene && worldGroup) {
            scene.remove(worldGroup);
            disposeGroup(worldGroup);
            worldGroup = new THREE.Group();
            scene.add(worldGroup);

            scene.background = new THREE.Color(cfg.skyColor);
            scene.fog = new THREE.FogExp2(cfg.fogColor, cfg.fogDensity);

            shaderUniforms.uColorPrimary.value = new THREE.Color(cfg.curbColor1);
            shaderUniforms.uColorSecondary.value = new THREE.Color(cfg.curbColor2);
            shaderUniforms.uSunTop.value = new THREE.Color(cfg.sunTopColor);
            shaderUniforms.uSunBottom.value = new THREE.Color(cfg.sunBottomColor);
            shaderUniforms.uFogColor.value = new THREE.Color(cfg.fogColor);
            shaderUniforms.uFogDensity.value = cfg.fogDensity;
            shaderUniforms.uSkyTop.value = new THREE.Color(cfg.skyColor);
            shaderUniforms.uSkyHorizon.value = new THREE.Color(cfg.fogColor).multiplyScalar(1.9);

            var vecPoints = cfg.points.map(function (p) { return new THREE.Vector3(p[0], p[1], p[2]); });
            trackCurve = new THREE.CatmullRomCurve3(vecPoints, true, 'catmullrom', 0.5);
            trackLength = trackCurve.getLength();

            trackFrames = { points: [], tangents: [], rights: [], ups: [] };
            var worldUp = new THREE.Vector3(0, 1, 0);
            for (var i = 0; i <= TRACK_SAMPLES; i++) {
                var u = (i % TRACK_SAMPLES) / TRACK_SAMPLES;
                var pt = trackCurve.getPointAt(u);
                var tan = trackCurve.getTangentAt(u).normalize();
                var right = new THREE.Vector3().crossVectors(tan, worldUp).normalize();
                var up = new THREE.Vector3().crossVectors(right, tan).normalize();
                trackFrames.points.push(pt);
                trackFrames.tangents.push(tan);
                trackFrames.rights.push(right);
                trackFrames.ups.push(up);
            }

            var roadPositions = [];
            var roadUVs = [];
            var roadIndices = [];
            var railLeftPoints = [];
            var railRightPoints = [];
            var uvRepeatLength = trackLength / 18;

            for (var j = 0; j <= TRACK_SAMPLES; j++) {
                var fPt = trackFrames.points[j];
                var fRight = trackFrames.rights[j];
                var vCoord = (j / TRACK_SAMPLES) * uvRepeatLength;

                var leftEdge = fPt.clone().addScaledVector(fRight, -ROAD_HALF_WIDTH);
                var rightEdge = fPt.clone().addScaledVector(fRight, ROAD_HALF_WIDTH);

                roadPositions.push(leftEdge.x, leftEdge.y, leftEdge.z);
                roadPositions.push(rightEdge.x, rightEdge.y, rightEdge.z);
                roadUVs.push(0, vCoord);
                roadUVs.push(1, vCoord);

                railLeftPoints.push(fPt.clone().addScaledVector(fRight, -(ROAD_HALF_WIDTH + 0.6)).add(new THREE.Vector3(0, 0.9, 0)));
                railRightPoints.push(fPt.clone().addScaledVector(fRight, (ROAD_HALF_WIDTH + 0.6)).add(new THREE.Vector3(0, 0.9, 0)));

                if (j < TRACK_SAMPLES) {
                    var a = j * 2;
                    var b = j * 2 + 1;
                    var c = (j + 1) * 2;
                    var d = (j + 1) * 2 + 1;
                    roadIndices.push(a, b, c);
                    roadIndices.push(b, d, c);
                }
            }

            var roadGeo = new THREE.BufferGeometry();
            roadGeo.setAttribute('position', new THREE.Float32BufferAttribute(roadPositions, 3));
            roadGeo.setAttribute('uv', new THREE.Float32BufferAttribute(roadUVs, 2));
            roadGeo.setIndex(roadIndices);
            roadGeo.computeVertexNormals();

            if (cfg.flying) {
                worldGroup.add(new THREE.Mesh(roadGeo, createHoloLaneMaterial(cfg)));
                buildFlyingRings(cfg);
            } else {
                worldGroup.add(new THREE.Mesh(roadGeo, createRoadShaderMaterial(cfg)));
                var deckGeo = roadGeo.clone();
                deckGeo.translate(0, -0.6, 0);
                worldGroup.add(new THREE.Mesh(deckGeo, new THREE.MeshBasicMaterial({ color: 0x090517, side: THREE.DoubleSide })));
            }

            var railMat = new THREE.MeshBasicMaterial({ color: cfg.railColor });
            worldGroup.add(new THREE.Mesh(new THREE.TubeGeometry(new THREE.CatmullRomCurve3(railLeftPoints, true), 320, 0.28, 6, true), railMat));
            worldGroup.add(new THREE.Mesh(new THREE.TubeGeometry(new THREE.CatmullRomCurve3(railRightPoints, true), 320, 0.28, 6, true), railMat));

            var startFrame = getFrameAtDistance(0, null);
            var finishLineMesh = new THREE.Mesh(
                new THREE.PlaneGeometry(ROAD_HALF_WIDTH * 2, 6),
                new THREE.MeshBasicMaterial({ map: checkerTexture, side: THREE.DoubleSide })
