                '    vec3 lit = mix(uLit1, uLit2, hash(id + 3.1)) * on * flick;',
                '    vec3 col = vec3(0.035, 0.025, 0.075) + vec3(0.02, 0.01, 0.04) * (vN.y * 0.5 + 0.5);',
                '    col += lit * win * side * uWin * 1.1;',
                '    col += uLit1 * 0.05 * smoothstep(0.7, 1.0, vN.y);',
                '    float dist = length(cameraPosition - vW);',
                '    float fogF = 1.0 - exp(-uFogDensity * uFogDensity * dist * dist);',
                '    col = mix(col, uFogColor, clamp(fogF, 0.0, 1.0));',
